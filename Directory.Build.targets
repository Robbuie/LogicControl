<Project>

  <!-- Imported AFTER the project body, so properties the .csproj sets are visible here.

       Shipping code builds with warnings as errors, as NetControl does. Turned on in 0.4.0, when
       the engine, the view models and the whole WPF app (XAML included) built with no warnings
       under the analyzers in Directory.Build.props. A warning a newer SDK adds fails the verify
       run; fix it rather than turning this off. -->
  <PropertyGroup Condition="'$(IsTestProject)' != 'true'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
