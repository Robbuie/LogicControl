<Tag Name="Speed_Ref" TagType="Base" DataType="REAL" Radix="Float" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="Line_Speed_Pct" TagType="Base" DataType="REAL" Radix="Float" Constant="false" ExternalAccess="Read/Write"/>
<!-- FINDING LC-LOG-001: written by two OTEs in Motors -->
<Tag Name="Conveyor_Run" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="Manual_Mode" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="Poll_Bit" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="Robot_Data" TagType="Base" DataType="UDT_RobotStatus" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="Robot_OK" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="VFD101_Status" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="M101" TagType="Base" DataType="Motor_Ctrl" Constant="false" ExternalAccess="Read/Write"/>
<!-- FINDING LC-LOG-002 -->
<Tag Name="Unused_Count" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="Robot_Read" TagType="Base" DataType="MESSAGE" ExternalAccess="Read/Write">
<Data Format="Message">
<MessageParameters MessageType="CIP Data Table Read" RequestedLength="1" ConnectedFlag="1" ConnectionPath="ENBT_2, 2, 192.168.10.5, 1, 0" CommTypeCode="0" ServiceCode="16#004c" ObjectType="16#0000" TargetObject="0" AttributeNumber="16#0000" LocalIndex="0" LocalElement="Robot_Data" RemoteIndex="0" RemoteElement="Robot_Status" CacheConnections="TRUE" LargePacketUsage="FALSE"/>
</Data>
</Tag>
<!-- FINDING LC-MSG-001 (never fired) and LC-MSG-002 (path starts at a module that does not exist) -->
<Tag Name="Scale_Msg" TagType="Base" DataType="MESSAGE" ExternalAccess="Read/Write">
<Data Format="Message">
<MessageParameters MessageType="CIP Generic" RequestedLength="0" ConnectedFlag="0" ConnectionPath="Old_ENBT, 2, 192.168.10.50" CommTypeCode="0" ServiceCode="16#000e" ObjectType="16#0004" TargetObject="101" AttributeNumber="16#0003" LocalIndex="0" LocalElement="Scale_Raw" CacheConnections="FALSE" LargePacketUsage="FALSE"/>
</Data>
</Tag>
<Tag Name="Line_Status" TagType="Produced" DataType="DINT" Radix="Decimal" ExternalAccess="Read/Write">
<ProduceInfo ProduceCount="2" PLCdataType="false" ProgrammaticallySendEventTrigger="false" UnicastPermitted="true" MinimumRPI="0.200" MaximumRPI="536870.900" DefaultRPI="20.000"/>
</Tag>
<Tag Name="Robot_Heartbeat" TagType="Consumed" DataType="DINT" Radix="Decimal" ExternalAccess="Read Only">
<ConsumeInfo Producer="Robot_PLC" RemoteTag="Heartbeat" RemoteInstance="0" RPI="50" Unicast="true"/>
</Tag>
<!-- FINDING LC-COM-002: the producer is not in the I/O tree -->
<Tag Name="Cell4_Data" TagType="Consumed" DataType="DINT" Radix="Decimal" ExternalAccess="Read Only">
<ConsumeInfo Producer="Cell4_PLC" RemoteTag="Status" RemoteInstance="0" RPI="100" Unicast="true"/>
</Tag>
</Tags>
<Programs>
<Program Name="MainProgram" TestEdits="false" MainRoutineName="MainRoutine" Disabled="false" UseAsFolder="false">
<Tags>
<Tag Name="Step" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="Seq_Done" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
</Tags>
<Routines>
<Routine Name="MainRoutine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Call the subroutines]]>
</Comment>
<Text>
<![CDATA[JSR(Motors,0)JSR(Comms,0)JSR(Calc,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Line run with timer]]>
</Comment>
<Text>
<![CDATA[XIC(Local:1:I.Data.0)XIO(Local:1:I.Data.1)XIC(E_Stop_OK)[OTE(Line_Running),XIC(Line_Running)TON(RunTimer,?,?)];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[EQU(Step,10)OTE(Seq_Done);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Motors" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(Line_Running)XIC(VFD_101:I.Ready)OTE(VFD_101:O.Start);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[MOV(Speed_Ref,VFD_101:O.FreqCommand);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(Line_Running)OTE(Conveyor_Run);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Manual jog - added during commissioning]]>
</Comment>
<Text>
<![CDATA[XIC(Manual_Mode)OTE(Conveyor_Run);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[Motor_Ctrl(M101,Local:2:O.Data.0,Conveyor_Run);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Rack1_AENT:I.Slot[1].Data.0)OTE(VFD_102:O.Start)MOV(Speed_Ref,VFD_102:O.FreqCommand);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[CPT(Step,(Step + 1) MOD 20);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Comms" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Read the robot status block every poll]]>
</Comment>
<Text>
<![CDATA[XIC(Poll_Bit)MSG(Robot_Read);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[GSV(Module,VFD_101,EntryStatus,VFD101_Status);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(Robot_Data.Ready)XIO(Robot_Data.Fault)NEQ(Robot_Heartbeat,0)OTE(Robot_OK);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[MOV(Step,Line_Status);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Calc" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[// Scale the line speed into drive Hz]]>
</Line>
<Line Number="1">
<![CDATA[Speed_Ref := Line_Speed_Pct * 0.6;]]>
</Line>
<Line Number="2">
<![CDATA[IF Speed_Ref > 60.0 THEN Speed_Ref := 60.0; END_IF;]]>
</Line>
</STContent>
</Routine>
<!-- FINDING LC-LOG-007 (never called) and LC-LOG-008 (Mystery_Bit is not declared) -->
<Routine Name="OldLogic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(Mystery_Bit)OTL(Manual_Mode);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
<!-- FINDING LC-LOG-006: in no task -->
<Program Name="Diagnostics" TestEdits="false" MainRoutineName="MainRoutine" Disabled="false" UseAsFolder="false">
<Tags/>
<Routines>
<Routine Name="MainRoutine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
<Tasks>
<Task Name="MainTask" Type="CONTINUOUS" Priority="10" Watchdog="500" DisableUpdateOutputs="false" InhibitTask="false">
<ScheduledPrograms>
<ScheduledProgram Name="MainProgram"/>
</ScheduledPrograms>
</Task>
