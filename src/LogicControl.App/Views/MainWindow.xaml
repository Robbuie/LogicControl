<Window x:Class="LogicControl.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LogicControl.App.ViewModels"
        xmlns:views="clr-namespace:LogicControl.App.Views"
        xmlns:dev="clr-namespace:LogicControl.App.ViewModels.Develop"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding Title}"
        Height="800" Width="1320"
        MinHeight="520" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Style="{StaticResource ChromeWindow}">

  <!-- The layout is NetControl's and File Manager's: a backdrop with the title bar on it (menu in
       the title bar), a toolbar row, and rounded cards for the working areas - a project navigator
       on the left and the tabs on the right. -->

  <Window.Resources>
    <!-- Handed to the shared title bar by the constructor through Chrome.TitleContent - see the
         note in NetControl's MainWindow on why this is not attribute syntax (MC3089). -->
    <Menu x:Key="TitleMenu" Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Center">
      <MenuItem Header="_File">
        <MenuItem Header="_Open L5X export..." Click="OnOpen" InputGestureText="Ctrl+O" />
        <MenuItem Header="_Reload" Command="{Binding ReloadCommand}" InputGestureText="F5"
                  ToolTip="Read the same file again - after a fresh export from Studio 5000." />
        <MenuItem Header="_Close" Command="{Binding CloseCommand}" />
        <Separator />
        <MenuItem Header="_New development set" Click="OnDevelopNew" />
        <MenuItem Header="Open _development set..." Click="OnDevelopOpen" />
        <MenuItem Header="_Save development set" Click="OnDevelopSave" InputGestureText="Ctrl+S" />
        <Separator />
        <MenuItem Header="E_xit" Click="OnExit" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Overview" Click="OnShowTab" Tag="0" InputGestureText="Ctrl+1" />
        <MenuItem Header="_Hardware" Click="OnShowTab" Tag="1" InputGestureText="Ctrl+2" />
        <MenuItem Header="_Communications" Click="OnShowTab" Tag="2" InputGestureText="Ctrl+3" />
        <MenuItem Header="_Tags" Click="OnShowTab" Tag="3" InputGestureText="Ctrl+4" />
        <MenuItem Header="_Logic" Click="OnShowTab" Tag="4" InputGestureText="Ctrl+5" />
        <MenuItem Header="Logic as l_adder" IsCheckable="True" IsChecked="{Binding ShowLadder, Mode=TwoWay}" InputGestureText="Ctrl+L" />
        <MenuItem Header="_Findings" Click="OnShowTab" Tag="5" InputGestureText="Ctrl+6" />
        <MenuItem Header="_Develop" Click="OnShowDevelop" InputGestureText="Ctrl+7" />
        <Separator />
        <!-- The same three axes as Redline PDF, the DWG viewer, File Manager and NetControl. -->
        <MenuItem Header="_Appearance..." Click="OnAppearance"
                  ToolTip="Theme, accent colour and density. Applied as you choose, saved when you press OK." />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="How to export an _L5X..." Click="OnHowToExport" />
        <Separator />
        <MenuItem Header="Check for _updates..." Click="OnCheckForUpdates" />
        <MenuItem Header="_Releases page" Click="OnOpenReleases" />
        <MenuItem Header="Open the diagnostic _log folder" Click="OnOpenLogFolder" />
        <Separator />
        <MenuItem Header="_About LogicControl" Click="OnAbout" />
      </MenuItem>
    </Menu>

    <!-- Navigator rows: icon, name, a muted badge, and a status dot when something is wrong. -->
    <HierarchicalDataTemplate DataType="{x:Type vm:NavNodeViewModel}" ItemsSource="{Binding Children}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="22" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="14" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Style="{StaticResource Glyph}" FontSize="13" Text="{Binding Glyph}" />
        <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Style="{StaticResource Muted}" Text="{Binding Badge}" Margin="8,0,0,0" VerticalAlignment="Center" />
        <Ellipse Grid.Column="3" Style="{StaticResource LevelDot}" HorizontalAlignment="Right" />
      </Grid>
    </HierarchicalDataTemplate>
  </Window.Resources>

  <Grid Margin="8,0,8,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="{DynamicResource status-h-grid}" />
    </Grid.RowDefinitions>

    <!-- ================================================================ toolbar -->
    <DockPanel Grid.Row="0" Margin="2,2,2,8" LastChildFill="False">
      <Button DockPanel.Dock="Left" Style="{StaticResource PrimaryButton}" Click="OnOpen"
              ToolTip="Open a Studio 5000 L5X export (Ctrl+O). You can also drop the file on this window.">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Glyph}" FontSize="12" Text="&#xE8E5;" Margin="0,0,8,0" />
          <TextBlock Text="Open L5X" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Command="{Binding ReloadCommand}"
              ToolTip="Read the file again (F5)">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Glyph}" FontSize="12" Text="&#xE72C;" Margin="0,0,6,0" />
          <TextBlock Text="Reload" VerticalAlignment="Center" />
        </StackPanel>
      </Button>

      <Border DockPanel.Dock="Left" Style="{StaticResource ToolbarSeparator}" />

      <!-- The filter: narrows every grid at once. A watermark rather than a label, so the toolbar
           stays one quiet row. -->
      <Grid DockPanel.Dock="Left" Width="320" VerticalAlignment="Center">
        <TextBox x:Name="SearchBox" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                 Padding="26,0,8,0" VerticalContentAlignment="Center" />
        <TextBlock Style="{StaticResource Glyph}" FontSize="12" Text="&#xE721;" Margin="9,0,0,0"
                   Foreground="{DynamicResource txt-2}" IsHitTestVisible="False" HorizontalAlignment="Left" />
        <TextBlock Text="Filter modules, links, tags, findings   (Ctrl+F)" Margin="27,0,0,0"
                   VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource txt-2}">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>

      <!-- What is open, at the far right. -->
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                  Visibility="{Binding HasProject, Converter={StaticResource BoolToVisible}}">
        <TextBlock Style="{StaticResource PanelTitle}" Text="{Binding Overview.ControllerName}" VerticalAlignment="Center" />
        <TextBlock Style="{StaticResource Muted}" Text="{Binding Overview.ControllerLine}" Margin="10,0,0,0" VerticalAlignment="Center" />
      </StackPanel>
    </DockPanel>

    <!-- ================================================================ error -->
    <Border Grid.Row="1" Style="{StaticResource FaultNotice}" Margin="2,0,2,8"
            Visibility="{Binding HasError, Converter={StaticResource BoolToVisible}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Click="OnDismissError" Content="Dismiss" />
        <TextBlock Style="{StaticResource FaultText}" Text="{Binding Error}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <!-- ================================================================ empty state -->
    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="2,0,2,8"
            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
        <TextBlock Style="{StaticResource Glyph}" FontSize="44" Text="&#xE8E5;" HorizontalAlignment="Center"
                   Foreground="{DynamicResource accent}" Margin="0,0,0,16" />
        <TextBlock Text="Open a controller" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"
                   Foreground="{DynamicResource txt-0}" />
        <TextBlock Margin="0,10,0,18" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource txt-1}"
                   Text="Drop a Studio 5000 L5X export here, or open one. LogicControl reads the I/O tree, every connection and message, the tags and the logic, and lists what looks wrong." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Button Style="{StaticResource PrimaryButton}" Click="OnOpen" Content="Open L5X export..." />
          <Button Command="{Binding StartDevelopingCommand}" Content="Write logic without a project" Margin="6,0,0,0"
                  ToolTip="Draft data types, AOIs and routines and export them as L5X for Studio 5000 to import" />
        </StackPanel>
        <TextBlock Style="{StaticResource Muted}" Margin="0,18,0,0" TextWrapping="Wrap" TextAlignment="Center"
                   Text="Have an .ACD? In Studio 5000 use File &gt; Save As and set the type to L5X - the .ACD format is Rockwell's own binary and is not read directly." />
      </StackPanel>
    </Border>

    <!-- ================================================================ busy -->
    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="2,0,2,8"
            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <ProgressBar IsIndeterminate="True" Width="220" Height="3" Margin="0,0,0,12" BorderThickness="0"
                     Foreground="{DynamicResource accent}" Background="{DynamicResource bg-3}" />
        <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Center" Foreground="{DynamicResource txt-1}" />
      </StackPanel>
    </Border>

    <!-- ================================================================ workspace -->
    <Grid Grid.Row="2" Margin="2,0,2,8" Visibility="{Binding ShowWorkspace, Converter={StaticResource BoolToVisible}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{DynamicResource side-w-grid}" MinWidth="200" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" MinWidth="480" />
      </Grid.ColumnDefinitions>

      <!-- Navigator -->
      <Border Grid.Column="0" Style="{StaticResource Card}" Padding="6,10,6,6">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelHead}" Text="CONTROLLER ORGANIZER" Margin="6,0,0,8" />
          <TreeView x:Name="Navigator" ItemsSource="{Binding Navigator}" SelectedItemChanged="OnNavigatorSelected" />
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Style="{StaticResource ColumnSplitter}" />

      <!-- Tabs -->
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
        <TabControl x:Name="Tabs" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}" Margin="6,4,6,6">

          <!-- ======================================================== overview -->
          <TabItem Header="Overview">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,14,10,10">
              <StackPanel DataContext="{Binding Overview}">
                <TextBlock Text="{Binding ControllerName}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource txt-0}" />
                <TextBlock Text="{Binding ControllerLine}" Foreground="{DynamicResource txt-1}" Margin="0,4,0,0" />
                <TextBlock Text="{Binding ControllerDescription}" Foreground="{DynamicResource txt-1}" Margin="0,2,0,0"
                           Visibility="{Binding ControllerDescription, Converter={StaticResource NotNullToVisible}}" />
                <TextBlock Style="{StaticResource Muted}" Text="{Binding ExportLine}" Margin="0,4,0,18" />

                <ItemsControl ItemsSource="{Binding Cards}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:StatCard}">
                      <Border Background="{DynamicResource bg-1}" BorderBrush="{DynamicResource line-soft}" BorderThickness="1"
                              CornerRadius="{DynamicResource corner}" Padding="14,12" Margin="0,0,10,10">
                        <StackPanel>
                          <TextBlock Style="{StaticResource PanelHead}" Text="{Binding Title}" />
                          <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                            <TextBlock Style="{StaticResource BigNumber}" Text="{Binding Value}" />
                            <TextBlock Style="{StaticResource Muted}" Text="{Binding Unit}" Margin="8,0,0,5" VerticalAlignment="Bottom" />
                          </StackPanel>
                          <TextBlock Style="{StaticResource Muted}" Text="{Binding Detail}" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2*" />
                  </Grid.ColumnDefinitions>

                  <!-- Networks this controller reaches -->
                  <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock Style="{StaticResource PanelHead}" Text="ETHERNET NETWORKS" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Networks}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NetworkSummary}">
                          <Border BorderBrush="{DynamicResource line-soft}" BorderThickness="0,0,0,1" Padding="0,7">
                            <DockPanel>
                              <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center">
                                <Run Text="{Binding Devices, Mode=OneWay}" /><Run Text=" devices" />
                              </TextBlock>
                              <TextBlock Style="{StaticResource Glyph}" Text="&#xE968;" Margin="0,0,8,0" Foreground="{DynamicResource info}" />
                              <StackPanel>
                                <TextBlock Style="{StaticResource MonoText}" Text="{Binding Address}" Foreground="{DynamicResource txt-0}" />
                                <TextBlock Style="{StaticResource Muted}">
                                  <Run Text="via " /><Run Text="{Binding Via, Mode=OneWay}" />
                                </TextBlock>
                              </StackPanel>
                            </DockPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                  <!-- Findings summary -->
                  <StackPanel Grid.Column="1">
                    <DockPanel Margin="0,0,0,8">
                      <TextBlock Style="{StaticResource PanelHead}" Text="FINDINGS" VerticalAlignment="Center" />
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource bad}" VerticalAlignment="Center" />
                        <TextBlock Margin="5,0,14,0" Foreground="{DynamicResource txt-1}">
                          <Run Text="{Binding Errors, Mode=OneWay}" /><Run Text=" errors" />
                        </TextBlock>
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource warn}" VerticalAlignment="Center" />
                        <TextBlock Margin="5,0,14,0" Foreground="{DynamicResource txt-1}">
                          <Run Text="{Binding Warnings, Mode=OneWay}" /><Run Text=" warnings" />
                        </TextBlock>
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource info}" VerticalAlignment="Center" />
                        <TextBlock Margin="5,0,0,0" Foreground="{DynamicResource txt-1}">
                          <Run Text="{Binding Infos, Mode=OneWay}" /><Run Text=" notes" />
                        </TextBlock>
                      </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding TopFindings}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FindingRowViewModel}">
                          <Border BorderBrush="{DynamicResource line-soft}" BorderThickness="0,0,0,1" Padding="0,7">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <Ellipse Grid.Column="0" Style="{StaticResource LevelDot}" VerticalAlignment="Top" Margin="0,5,0,0" />
                              <TextBlock Grid.Column="1" Text="{Binding Subject}" FontWeight="SemiBold" Foreground="{DynamicResource txt-0}"
                                         Margin="0,0,12,0" MaxWidth="200" TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource txt-1}" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource ToolButton}" HorizontalAlignment="Left" Margin="0,8,0,0"
                            Click="OnShowTab" Tag="5" Content="All findings  &#x2192;" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <!-- ======================================================== hardware -->
          <TabItem Header="{Binding HardwareHeader}">
            <Grid Margin="0,8,0,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <DataGrid x:Name="HardwareGrid" Grid.Row="0" ItemsSource="{Binding Hardware}" SelectedItem="{Binding SelectedModule, Mode=TwoWay}"
                        AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                        SelectionMode="Single" CanUserAddRows="False" BorderThickness="0"
                        EnableRowVirtualization="True">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Width="22" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Ellipse Style="{StaticResource LevelDot}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Module" Width="230" SortMemberPath="Name">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                          <Border Width="{Binding Indent}" />
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Catalog" Binding="{Binding Catalog}" Width="150" />
                  <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}" />
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn Header="Rev" Binding="{Binding Revision}" Width="56" />
                  <DataGridTextColumn Header="RPI" Binding="{Binding Rpi}" Width="64" />
                  <DataGridTextColumn Header="Connection" Binding="{Binding Connection}" Width="110" />
                  <DataGridTextColumn Header="Keying" Binding="{Binding Keying}" Width="120" />
                  <DataGridTextColumn Header="Logic refs" Binding="{Binding LogicReferences}" Width="72" />
                  <DataGridTextColumn Header="Notes" Binding="{Binding Flags}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>

              <!-- The selected module: where it is, what it is for, what is wrong with it. -->
              <Border Grid.Row="1" Background="{DynamicResource bg-1}" BorderBrush="{DynamicResource line-soft}" BorderThickness="0,1,0,0"
                      Padding="12,10" DataContext="{Binding SelectedModule}"
                      Visibility="{Binding Converter={StaticResource NotNullToVisible}}">
                <StackPanel>
                  <TextBlock>
                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource txt-0}" />
                    <Run Text="   " />
                    <Run Text="{Binding Path, Mode=OneWay}" Foreground="{DynamicResource txt-2}" />
                  </TextBlock>
                  <TextBlock Text="{Binding Description}" Foreground="{DynamicResource txt-1}" Margin="0,4,0,0" TextWrapping="Wrap"
                             Visibility="{Binding Description, Converter={StaticResource NotNullToVisible}}" />
                  <ItemsControl ItemsSource="{Binding Findings}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource txt-1}" Margin="0,2,0,0" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </Grid>
          </TabItem>

          <!-- ======================================================== communications -->
          <TabItem Header="{Binding CommsHeader}">
            <DataGrid ItemsSource="{Binding Communications}" Margin="0,8,0,0"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                      SelectionMode="Single" CanUserAddRows="False" BorderThickness="0">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Kind" Width="140" SortMemberPath="Kind">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource KindChip}" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Kind}" Style="{StaticResource Muted}" Foreground="{DynamicResource txt-0}" />
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="From" Binding="{Binding From}" Width="130" />
                <DataGridTextColumn Header="To" Binding="{Binding To}" Width="150" />
                <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="130">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}" />
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="RPI" Binding="{Binding Rpi}" Width="64" />
                <DataGridTextColumn Header="What moves" Binding="{Binding Detail}" Width="2*" />
                <DataGridTextColumn Header="Configured at" Binding="{Binding Source}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>

          <!-- ======================================================== tags -->
          <TabItem Header="{Binding TagsHeader}">
            <Grid Margin="0,8,0,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120" />
                <RowDefinition Height="8" />
                <RowDefinition Height="220" MinHeight="80" />
              </Grid.RowDefinitions>

              <DataGrid Grid.Row="0" ItemsSource="{Binding Tags}" SelectedItem="{Binding SelectedTag, Mode=TwoWay}"
                        AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                        SelectionMode="Single" CanUserAddRows="False" BorderThickness="0"
                        EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" FontWeight="SemiBold" />
                  <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="110" />
                  <DataGridTextColumn Header="Data type" Binding="{Binding DataType}" Width="130" />
                  <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="190" />
                  <DataGridTextColumn Header="Reads" Binding="{Binding Reads}" Width="56" />
                  <DataGridTextColumn Header="Writes" Binding="{Binding Writes}" Width="56" />
                  <DataGridTextColumn Header="Usage" Binding="{Binding Usage}" Width="90" />
                  <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>

              <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" />

              <!-- Cross reference for the selected tag -->
              <DockPanel Grid.Row="2">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelHead}" Margin="4,0,0,6">
                  <Run Text="CROSS REFERENCE  " /><Run Text="{Binding SelectedTag.Name, Mode=OneWay}" Foreground="{DynamicResource txt-0}" />
                </TextBlock>
                <DataGrid ItemsSource="{Binding SelectedTag.Uses}"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                          SelectionMode="Single" CanUserAddRows="False" BorderThickness="0">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Access" Binding="{Binding Access}" Width="64" />
                    <DataGridTextColumn Header="Routine" Binding="{Binding Routine}" Width="200" />
                    <DataGridTextColumn Header="Where" Binding="{Binding Location}" Width="80" />
                    <DataGridTextColumn Header="Instruction" Binding="{Binding Instruction}" Width="120" />
                    <DataGridTextColumn Header="Operand" Binding="{Binding Operand}" Width="*">
                      <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}" />
                      </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </Grid>
          </TabItem>

          <!-- ======================================================== logic -->
          <TabItem Header="Logic">
            <DockPanel Margin="0,8,0,0">
              <DockPanel DockPanel.Dock="Top" Margin="6,0,6,10">
                <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Edit a copy" Margin="10,0,0,0"
                        Command="{Binding EditRoutineCopyCommand}" VerticalAlignment="Center"
                        ToolTip="Copy this routine into the Develop tab to change it and export it back to Studio 5000" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding Routine.IsLadder, Converter={StaticResource BoolToVisible}, FallbackValue=Collapsed}">
                  <RadioButton Style="{StaticResource SegmentToggle}" Tag="first" Content="Ladder" GroupName="LogicMode"
                               IsChecked="{Binding ShowLadder, Mode=TwoWay}" ToolTip="Draw the rungs as ladder (Ctrl+L)" />
                  <RadioButton Style="{StaticResource SegmentToggle}" Tag="last" Content="Text" GroupName="LogicMode"
                               IsChecked="{Binding ShowText, Mode=TwoWay}" ToolTip="Show the neutral text Studio 5000 stores (Ctrl+L)" />
                </StackPanel>
                <TextBlock Style="{StaticResource PanelTitle}" Text="{Binding Routine.Title}" FontSize="16" VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource Muted}" Text="{Binding Routine.Summary}" Margin="12,0,0,0" VerticalAlignment="Center" />
              </DockPanel>

              <Grid>
                <!-- Ladder: one drawn rung per row, comment above it, number in the gutter. Scrolls
                     sideways for a rung wider than the window; the rung's own width tracks the
                     visible width so outputs still sit against the right rail. Click an operand
                     to open its tag. -->
                <ItemsControl x:Name="LadderList" ItemsSource="{Binding Routine.Lines}"
                              Visibility="{Binding LadderVisible, Converter={StaticResource BoolToVisible}}"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                  <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                      <ScrollViewer x:Name="LadderScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <ItemsPresenter />
                      </ScrollViewer>
                    </ControlTemplate>
                  </ItemsControl.Template>
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:LogicLineViewModel}">
                      <Border BorderBrush="{DynamicResource line-soft}" BorderThickness="0,0,0,1" Padding="0,6">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="0" Style="{StaticResource MonoText}" Text="{Binding Number}"
                                     Foreground="{DynamicResource txt-2}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                     Margin="0,4,10,0" />
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Comment}" FontStyle="Italic" Foreground="{DynamicResource good}" TextWrapping="Wrap"
                                       Margin="4,0,12,4" MaxWidth="900" HorizontalAlignment="Left"
                                       Visibility="{Binding HasComment, Converter={StaticResource BoolToVisible}}" />
                            <views:LadderRungView Style="{StaticResource LadderRung}"
                                                  Text="{Binding RungText}"
                                                  Shapes="{Binding DataContext.Routine.Shapes, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  OperandCommand="{Binding DataContext.ShowOperandCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  ViewportWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                  ViewportInset="64" Margin="0,0,8,0" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Text: one row per rung or ST line, the logic as coloured runs that wrap.
                     Virtualised, so a 3,000-rung routine scrolls. -->
                <ItemsControl ItemsSource="{Binding Routine.Lines}"
                              Visibility="{Binding TextVisible, Converter={StaticResource BoolToVisible}}"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True">
                  <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsPresenter />
                      </ScrollViewer>
                    </ControlTemplate>
                  </ItemsControl.Template>
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:LogicLineViewModel}">
                      <Border BorderBrush="{DynamicResource line-soft}" BorderThickness="0,0,0,1" Padding="0,8">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="0" Style="{StaticResource MonoText}" Text="{Binding Number}"
                                     Foreground="{DynamicResource txt-2}" HorizontalAlignment="Right" Margin="0,0,14,0" />
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Comment}" FontStyle="Italic" Foreground="{DynamicResource good}" TextWrapping="Wrap" Margin="0,0,0,4"
                                       Visibility="{Binding HasComment, Converter={StaticResource BoolToVisible}}" />
                            <ItemsControl ItemsSource="{Binding Segments}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <WrapPanel />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SegmentViewModel}">
                                  <TextBlock Style="{StaticResource Segment}" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </DockPanel>
          </TabItem>

          <!-- ======================================================== findings -->
          <TabItem Header="{Binding FindingsHeader}">
            <DataGrid ItemsSource="{Binding Findings}" Margin="0,8,0,0"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                      SelectionMode="Single" CanUserAddRows="False" BorderThickness="0" RowHeight="NaN">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Severity" Width="84" SortMemberPath="Level">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource LevelDot}" Margin="0,0,7,0" />
                        <TextBlock Style="{StaticResource LevelText}" />
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Rule" Binding="{Binding Rule}" Width="90">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}" />
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Area" Binding="{Binding Category}" Width="110" />
                <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="170" FontWeight="SemiBold" />
                <DataGridTextColumn Header="What and why" Binding="{Binding Message}" Width="3*">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                      <Setter Property="TextWrapping" Value="Wrap" />
                      <Setter Property="Margin" Value="0,6" />
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Where" Binding="{Binding Location}" Width="*">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                      <Setter Property="TextWrapping" Value="Wrap" />
                      <Setter Property="Foreground" Value="{DynamicResource txt-2}" />
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>

          <!-- ======================================================== develop -->
          <!-- Writing logic: data types, AOIs, programs, routines and tags as drafts, checked as
               they are typed, and exported as L5X for Studio 5000 to import - or written into a
               copy of the open project. The drafts list is on the left, the editor for the one
               selected on the right, and everything wrong with any of them underneath. -->
          <TabItem Header="{Binding DevelopHeader}">
            <Grid Margin="0,8,0,0" DataContext="{Binding Develop}">
              <Grid.Resources>
                <!-- ............................................ the rung list, shared by routines and AOIs -->
                <DataTemplate DataType="{x:Type dev:RungListViewModel}">
                  <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource SmallButton}" Content="Add rung" Command="{Binding AddCommand}" ToolTip="Add a rung below the selected one" />
                        <Button Style="{StaticResource SmallButton}" Content="Duplicate" Command="{Binding DuplicateCommand}" />
                        <Button Style="{StaticResource SmallButton}" Content="Up" Command="{Binding MoveUpCommand}" />
                        <Button Style="{StaticResource SmallButton}" Content="Down" Command="{Binding MoveDownCommand}" />
                        <Button Style="{StaticResource SmallButton}" Content="Delete" Command="{Binding RemoveCommand}" Margin="0,0,14,0" />
                      </StackPanel>
                      <ItemsControl x:Name="Snippets" ItemsSource="{Binding Snippets}" VerticalAlignment="Top">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="{x:Type dev:SnippetViewModel}">
                            <Button Style="{StaticResource SnippetButton}" Content="{Binding Label}" ToolTip="{Binding ToolTip}"
                                    Command="{Binding DataContext.InsertSnippetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding Text}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </DockPanel>

                    <ListBox Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource RungListItem}"
                             ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                             VirtualizingPanel.ScrollUnit="Pixel">
                      <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type dev:RungEditorViewModel}">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="40" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,4,8,0">
                              <TextBlock Style="{StaticResource MonoText}" Text="{Binding Number}" Foreground="{DynamicResource txt-2}" HorizontalAlignment="Right" />
                              <Ellipse Style="{StaticResource LevelDot}" HorizontalAlignment="Right" Margin="0,6,2,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                              <TextBox Text="{Binding Comment, UpdateSourceTrigger=LostFocus}" FontStyle="Italic"
                                       Foreground="{DynamicResource good}" Margin="0,0,0,4" ToolTip="Rung comment" />
                              <TextBox Style="{StaticResource RungBox}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                                       ToolTip="Neutral text, as Studio 5000 stores it: XIC(Start)[XIO(Stop),XIC(Run)]OTE(Run);" />
                              <views:LadderRungView Style="{StaticResource LadderRung}" Text="{Binding Text}" Shapes="{Binding Shapes}" Margin="0,6,0,0" />
                              <ItemsControl ItemsSource="{Binding Problems}" Margin="0,4,0,0"
                                            Visibility="{Binding HasProblems, Converter={StaticResource BoolToVisible}}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource txt-1}" Margin="0,1" />
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </DockPanel>
                </DataTemplate>

                <!-- ............................................ data type -->
                <DataTemplate DataType="{x:Type dev:UdtEditorViewModel}">
                  <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Data type name" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Description" />
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=LostFocus}" />
                      </StackPanel>
                    </Grid>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                      <Button Style="{StaticResource SmallButton}" Content="Add member" Command="{Binding AddCommand}" />
                      <Button Style="{StaticResource SmallButton}" Content="Remove" Command="{Binding RemoveCommand}" />
                      <Button Style="{StaticResource SmallButton}" Content="Up" Command="{Binding MoveUpCommand}" />
                      <Button Style="{StaticResource SmallButton}" Content="Down" Command="{Binding MoveDownCommand}" />
                    </StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="320" />
                      </Grid.ColumnDefinitions>
                      <DataGrid Grid.Column="0" ItemsSource="{Binding Members}" SelectedItem="{Binding SelectedMember, Mode=TwoWay}"
                                AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                                HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single">
                        <DataGrid.Columns>
                          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="170" />
                          <DataGridTemplateColumn Header="Data type" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding DataType}" VerticalAlignment="Center" Margin="4,0" />
                              </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                              <DataTemplate>
                                <ComboBox IsEditable="True" Text="{Binding DataType, UpdateSourceTrigger=LostFocus}"
                                          ItemsSource="{Binding DataContext.TypeChoices, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                              </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                          </DataGridTemplateColumn>
                          <DataGridTextColumn Header="Dim" Binding="{Binding Dimension}" Width="56" />
                          <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                        </DataGrid.Columns>
                      </DataGrid>
                      <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                                   Text="Or paste a member list - one per line: Name : TYPE // description. CSV and Excel columns work too." />
                        <Button DockPanel.Dock="Bottom" Style="{StaticResource SmallButton}" Content="Replace members with this list"
                                Command="{Binding ApplyPasteCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding PasteProblems}" Foreground="{DynamicResource bad}" TextWrapping="Wrap"
                                   Visibility="{Binding PasteProblems, Converter={StaticResource NotNullToVisible}}" Margin="0,6,0,0" />
                        <TextBox Style="{StaticResource MultiLineBox}" Text="{Binding PasteText, UpdateSourceTrigger=PropertyChanged}" />
                      </DockPanel>
                    </Grid>
                  </DockPanel>
                </DataTemplate>

                <!-- ............................................ routine -->
                <DataTemplate DataType="{x:Type dev:RoutineEditorViewModel}">
                  <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Routine name" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Program" />
                        <ComboBox IsEditable="True" ItemsSource="{Binding ProgramChoices}" Text="{Binding Program, UpdateSourceTrigger=LostFocus}" />
                      </StackPanel>
                      <StackPanel Grid.Column="4">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Description" />
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=LostFocus}" />
                      </StackPanel>
                    </Grid>
                    <ContentControl Content="{Binding Rungs}" />
                  </DockPanel>
                </DataTemplate>

                <!-- ............................................ program -->
                <DataTemplate DataType="{x:Type dev:ProgramEditorViewModel}">
                  <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Program name" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,10" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Description" />
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,10" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Main routine" />
                    <ComboBox IsEditable="True" ItemsSource="{Binding RoutineChoices}" Text="{Binding MainRoutineName, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,10" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Schedule in task (when writing into a project copy)" />
                    <ComboBox IsEditable="True" ItemsSource="{Binding TaskChoices}" Text="{Binding Task, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,10" />
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                               Text="Routines and tags drafted with this program's name go inside it. Renaming the program moves them with it." />
                  </StackPanel>
                </DataTemplate>

                <!-- ............................................ add-on instruction -->
                <DataTemplate DataType="{x:Type dev:AoiEditorViewModel}">
                  <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Add-On name" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Revision" />
                        <TextBox Text="{Binding Revision, UpdateSourceTrigger=LostFocus}" />
                      </StackPanel>
                      <StackPanel Grid.Column="4">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Description" />
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=LostFocus}" />
                      </StackPanel>
                    </Grid>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource MonoText}" Foreground="{DynamicResource txt-1}" Margin="0,0,0,8"
                               Text="{Binding CallSignature, StringFormat='Called as  {0}'}" />

                    <Grid DockPanel.Dock="Top" Height="210" Margin="0,0,0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="2*" />
                      </Grid.ColumnDefinitions>
                      <DockPanel Grid.Column="0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                          <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Remove" Command="{Binding RemoveParameterCommand}" Margin="0" />
                          <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Add" Command="{Binding AddParameterCommand}" />
                          <TextBlock Style="{StaticResource PanelHead}" Text="PARAMETERS" VerticalAlignment="Center" />
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding Parameters}" SelectedItem="{Binding SelectedParameter, Mode=TwoWay}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single">
                          <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="130" />
                            <DataGridTemplateColumn Header="Data type" Width="110">
                              <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                  <TextBlock Text="{Binding DataType}" VerticalAlignment="Center" Margin="4,0" />
                                </DataTemplate>
                              </DataGridTemplateColumn.CellTemplate>
                              <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                  <ComboBox IsEditable="True" Text="{Binding DataType, UpdateSourceTrigger=LostFocus}"
                                            ItemsSource="{Binding DataContext.TypeChoices, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                </DataTemplate>
                              </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Usage" Width="86">
                              <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                  <TextBlock Text="{Binding Usage}" VerticalAlignment="Center" Margin="4,0" />
                                </DataTemplate>
                              </DataGridTemplateColumn.CellTemplate>
                              <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                  <ComboBox SelectedItem="{Binding Usage, UpdateSourceTrigger=PropertyChanged}"
                                            ItemsSource="{Binding DataContext.UsageChoices, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                </DataTemplate>
                              </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridCheckBoxColumn Header="Req" Binding="{Binding Required, UpdateSourceTrigger=PropertyChanged}" Width="44" />
                            <DataGridCheckBoxColumn Header="Vis" Binding="{Binding Visible, UpdateSourceTrigger=PropertyChanged}" Width="44" />
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                          </DataGrid.Columns>
                        </DataGrid>
                      </DockPanel>
                      <DockPanel Grid.Column="2">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                          <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Remove" Command="{Binding RemoveLocalCommand}" Margin="0" />
                          <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Add" Command="{Binding AddLocalCommand}" />
                          <TextBlock Style="{StaticResource PanelHead}" Text="LOCAL TAGS" VerticalAlignment="Center" />
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding LocalTags}" SelectedItem="{Binding SelectedLocal, Mode=TwoWay}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single">
                          <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="120" />
                            <DataGridTemplateColumn Header="Data type" Width="110">
                              <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                  <TextBlock Text="{Binding DataType}" VerticalAlignment="Center" Margin="4,0" />
                                </DataTemplate>
                              </DataGridTemplateColumn.CellTemplate>
                              <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                  <ComboBox IsEditable="True" Text="{Binding DataType, UpdateSourceTrigger=LostFocus}"
                                            ItemsSource="{Binding DataContext.TypeChoices, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                </DataTemplate>
                              </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Dim" Binding="{Binding Dimension}" Width="50" />
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                          </DataGrid.Columns>
                        </DataGrid>
                      </DockPanel>
                    </Grid>

                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelHead}" Text="LOGIC" Margin="0,0,0,6" />
                    <ContentControl Content="{Binding Rungs}" />
                  </DockPanel>
                </DataTemplate>

                <!-- ............................................ tags -->
                <DataTemplate DataType="{x:Type dev:TagsEditorViewModel}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="12" />
                      <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Style="{StaticResource SmallButton}" Content="Add tag" Command="{Binding AddCommand}" />
                        <Button Style="{StaticResource SmallButton}" Content="Remove" Command="{Binding RemoveCommand}" />
                      </StackPanel>
                      <DataGrid ItemsSource="{Binding Tags}" SelectedItem="{Binding SelectedTag, Mode=TwoWay}"
                                AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single">
                        <DataGrid.Columns>
                          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160" />
                          <DataGridTemplateColumn Header="Scope" Width="130" SortMemberPath="Scope">
                            <DataGridTemplateColumn.CellTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding Scope}" VerticalAlignment="Center" Margin="4,0" />
                              </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                              <DataTemplate>
                                <ComboBox IsEditable="True" Text="{Binding Scope, UpdateSourceTrigger=LostFocus}"
                                          ItemsSource="{Binding DataContext.ScopeChoices, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                              </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                          </DataGridTemplateColumn>
                          <DataGridTemplateColumn Header="Data type" Width="130" SortMemberPath="DataType">
                            <DataGridTemplateColumn.CellTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding DataType}" VerticalAlignment="Center" Margin="4,0" />
                              </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                              <DataTemplate>
                                <ComboBox IsEditable="True" Text="{Binding DataType, UpdateSourceTrigger=LostFocus}"
                                          ItemsSource="{Binding DataContext.TypeChoices, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                              </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                          </DataGridTemplateColumn>
                          <DataGridTextColumn Header="Dims" Binding="{Binding Dimensions}" Width="60" />
                          <DataGridTextColumn Header="Alias for" Binding="{Binding AliasFor}" Width="140" />
                          <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                        </DataGrid.Columns>
                      </DataGrid>
                    </DockPanel>
                    <DockPanel Grid.Column="2">
                      <TextBlock DockPanel.Dock="Top" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                                 Text="Paste a tag list - Name : TYPE // description per line, or Name, Type, Description columns from Excel." />
                      <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Add these tags" Command="{Binding ApplyPasteCommand}" Margin="6,0,0,0" />
                        <ComboBox IsEditable="True" ItemsSource="{Binding ScopeChoices}" Text="{Binding PasteScope, UpdateSourceTrigger=LostFocus}" ToolTip="Scope for the pasted tags" />
                      </DockPanel>
                      <TextBlock DockPanel.Dock="Bottom" Text="{Binding PasteProblems}" Foreground="{DynamicResource bad}" TextWrapping="Wrap"
                                 Visibility="{Binding PasteProblems, Converter={StaticResource NotNullToVisible}}" Margin="0,6,0,0" />
                      <TextBox Style="{StaticResource MultiLineBox}" Text="{Binding PasteText, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                  </Grid>
                </DataTemplate>

                <!-- ............................................ templates -->
                <DataTemplate DataType="{x:Type dev:TemplateGeneratorViewModel}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="280" />
                      <ColumnDefinition Width="16" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ListBox Grid.Column="0" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource PlainListItem}"
                             ItemsSource="{Binding Templates}" SelectedItem="{Binding Template, Mode=TwoWay}">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                      <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Instances - M101, M102 or a range such as M101-M110" />
                        <TextBox Text="{Binding Instances, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource Muted}" Text="{Binding Preview}" Margin="0,4,0,12" TextWrapping="Wrap" />

                        <Grid Margin="0,0,0,10">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Data type / Add-On name" />
                            <TextBox Text="{Binding TypeName, UpdateSourceTrigger=PropertyChanged}" />
                          </StackPanel>
                          <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Routine name" />
                            <TextBox Text="{Binding Routine, UpdateSourceTrigger=PropertyChanged}" />
                          </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Program" />
                        <ComboBox IsEditable="True" ItemsSource="{Binding ProgramChoices}" Text="{Binding Program, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                        <CheckBox Content="Create this program (it is not in the project yet)" IsChecked="{Binding CreateProgram}" Margin="0,0,0,6" />
                        <ComboBox IsEditable="True" ItemsSource="{Binding TaskChoices}" Text="{Binding Task, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="Task to schedule the new program in" Margin="20,0,0,8"
                                  Visibility="{Binding CreateProgram, Converter={StaticResource BoolToVisible}}" />
                        <CheckBox Content="Program-scoped tags (otherwise controller scope, where the HMI can reach them)" IsChecked="{Binding ProgramScopeTags}" Margin="0,0,0,12" />

                        <ItemsControl ItemsSource="{Binding Settings}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type dev:TemplateSettingRowViewModel}">
                              <StackPanel Margin="0,0,0,8">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Label}" />
                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="160" HorizontalAlignment="Left" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Style="{StaticResource PrimaryButton}" Content="Generate" Command="{Binding GenerateCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource bad}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding Error, Converter={StaticResource NotNullToVisible}}" />
                      </StackPanel>
                    </ScrollViewer>
                  </Grid>
                </DataTemplate>
              </Grid.Resources>

              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="200" />
                <RowDefinition Height="8" />
                <RowDefinition Height="150" MinHeight="60" />
              </Grid.RowDefinitions>

              <!-- Toolbar: make things on the left, take them out on the right. -->
              <DockPanel Grid.Row="0" Margin="6,0,6,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button Style="{StaticResource SmallButton}" Content="Open..." Click="OnDevelopOpen" ToolTip="Open a saved development set (.lcdev)" />
                  <Button Style="{StaticResource SmallButton}" Content="Save..." Click="OnDevelopSave" ToolTip="Save the drafts to carry on later (Ctrl+S)" />
                  <Button Style="{StaticResource SmallButton}" Content="Export import files..." Click="OnDevelopExport" IsEnabled="{Binding CanExport}"
                          ToolTip="Write one L5X per item, numbered in import order, for Studio 5000's Import" />
                  <Button Style="{StaticResource PrimaryButton}" Content="Write into project copy..." Click="OnDevelopMerge" IsEnabled="{Binding CanMerge}"
                          ToolTip="{Binding MergeHint}" ToolTipService.ShowOnDisabled="True" Margin="4,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Button Style="{StaticResource SmallButton}" Content="Data type" Command="{Binding NewDataTypeCommand}" ToolTip="New user-defined data type" />
                  <Button Style="{StaticResource SmallButton}" Content="Add-On" Command="{Binding NewAoiCommand}" ToolTip="New Add-On Instruction" />
                  <Button Style="{StaticResource SmallButton}" Content="Program" Command="{Binding NewProgramCommand}" ToolTip="New program with a main routine" />
                  <Button Style="{StaticResource SmallButton}" Content="Routine" Command="{Binding NewRoutineCommand}" ToolTip="New ladder routine" />
                  <Button Style="{StaticResource SmallButton}" Content="Tags" Command="{Binding EditTagsCommand}" ToolTip="Drafted tags" />
                  <Button Style="{StaticResource SmallButton}" Content="From template..." Command="{Binding FromTemplateCommand}"
                          ToolTip="Generate a UDT, tags and rungs for a list of motors, valves, alarms..." />
                  <Border Style="{StaticResource ToolbarSeparator}" />
                  <Button Style="{StaticResource SmallButton}" Content="Delete" Command="{Binding DeleteCommand}" ToolTip="Delete the selected draft" />
                </StackPanel>
              </DockPanel>

              <!-- What is open, what it targets, how it stands. -->
              <DockPanel Grid.Row="1" Margin="6,0,6,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Muted}" Text="Controller" VerticalAlignment="Center" Margin="0,0,6,0" />
                  <TextBox Text="{Binding ControllerName, UpdateSourceTrigger=LostFocus}" Width="150" />
                  <TextBlock Style="{StaticResource Muted}" Text="Studio 5000 v" VerticalAlignment="Center" Margin="12,0,4,0" />
                  <TextBox Text="{Binding SoftwareRevision, UpdateSourceTrigger=LostFocus}" Width="60"
                           ToolTip="Stamped on the files. Studio 5000 refuses a file stamped newer than itself." />
                </StackPanel>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource txt-0}" VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource Muted}" Text="{Binding IssueSummary}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
              </DockPanel>

              <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="250" MinWidth="160" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ListBox x:Name="DraftList" Grid.Column="0" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource PlainListItem}"
                         ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
                  <ListBox.GroupStyle>
                    <GroupStyle>
                      <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                          <TextBlock Style="{StaticResource PanelHead}" Text="{Binding Name}" Margin="8,10,0,4" />
                        </DataTemplate>
                      </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                  </ListBox.GroupStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type dev:DraftItemViewModel}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="14" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Style="{StaticResource LevelDot}" VerticalAlignment="Top" Margin="0,5,0,0" HorizontalAlignment="Left" />
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <GridSplitter Grid.Column="1" Style="{StaticResource ColumnSplitter}" />

                <Grid Grid.Column="2" Margin="4,0,6,0">
                  <ContentControl Content="{Binding Editor}" />

                  <!-- Nothing selected: say what this tab is for. -->
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520"
                              Visibility="{Binding Editor, Converter={StaticResource NullToVisible}}">
                    <TextBlock Text="Write logic for Studio 5000" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource txt-0}" HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,16"
                               Text="Draft data types, Add-On Instructions, programs, routines and tags here - or generate them from a template - and LogicControl checks them as you type and draws every rung. Export them as L5X to import into Studio 5000, or write them into a copy of the open project. On the Logic tab, 'Edit a copy' brings an existing routine here." />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                      <Button Style="{StaticResource PrimaryButton}" Content="From template..." Command="{Binding FromTemplateCommand}" />
                      <Button Content="New routine" Command="{Binding NewRoutineCommand}" Margin="6,0,0,0" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </Grid>

              <GridSplitter Grid.Row="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows" />

              <!-- Issues: double-click one to open the draft - and the rung - it is about. -->
              <DockPanel Grid.Row="4">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelHead}" Text="CHECKS" Margin="6,0,0,4" />
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" Text="{Binding Message}" TextWrapping="Wrap" Margin="6,6,6,0"
                           Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisible}}" />
                <DataGrid x:Name="IssueGrid" ItemsSource="{Binding Issues}" MouseDoubleClick="OnIssueDoubleClick"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                          SelectionMode="Single" CanUserAddRows="False" BorderThickness="0">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="28" SortMemberPath="Level">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <Ellipse Style="{StaticResource LevelDot}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Where" Binding="{Binding Where}" Width="260" />
                    <DataGridTextColumn Header="What" Binding="{Binding Message}" Width="*" />
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </Grid>
          </TabItem>
        </TabControl>
      </Border>
    </Grid>

    <!-- ================================================================ status bar -->
    <DockPanel Grid.Row="3" Margin="4,0">
      <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center"
                 Text="Never connects to a controller - everything goes through Studio 5000" />
      <!-- Only there when a newer build is published. Click to update. -->
      <TextBlock DockPanel.Dock="Right" Text="{Binding UpdateStatus}" Foreground="{DynamicResource accent-on-chrome}"
                 VerticalAlignment="Center" Margin="0,0,18,0" Cursor="Hand" TextDecorations="Underline"
                 MouseLeftButtonUp="OnUpdateStatusClicked" ToolTip="Download and install the new version"
                 Visibility="{Binding UpdateStatus, Converter={StaticResource NotNullToVisible}}" />
      <TextBlock Style="{StaticResource Muted}" Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    </DockPanel>
  </Grid>
</Window>
