<Window x:Class="LogicControl.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LogicControl.App.ViewModels"
        xmlns:views="clr-namespace:LogicControl.App.Views"
        xmlns:dev="clr-namespace:LogicControl.App.ViewModels.Develop"
        xmlns:asst="clr-namespace:LogicControl.App.ViewModels.Assistant"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding Title}"
        Height="800" Width="1320"
        MinHeight="520" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Style="{StaticResource ChromeWindow}">

  <!-- The layout is NetControl's and File Manager's: a backdrop with the title bar on it (menu in
       the title bar), a toolbar row, and rounded cards for the working areas - a project navigator
       on the left and the tabs on the right. -->

  <Window.Resources>
    <!-- The lines of one change - rungs drawn as ladder or listed as text - shared by History and Compare. -->
    <DataTemplate x:Key="ChangeLines" DataType="{x:Type dev:ItemChangeViewModel}">
            <ItemsControl ItemsSource="{Binding Lines}" Margin="0,6,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type dev:DiffLineViewModel}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource DiffLineText}" Text="{Binding Text}"
                               Visibility="{Binding IsPrinted, Converter={StaticResource BoolToVisible}}" />
      
                    <!-- A rung drawn as ladder: a coloured bar for added or removed, its label and comment above -->
                    <Border Style="{StaticResource LogicLineRow}" Padding="0,4"
                            Visibility="{Binding IsDrawn, Converter={StaticResource BoolToVisible}}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="8" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource ChangeBar}" />
                        <StackPanel Grid.Column="1">
                          <TextBlock Margin="2,0,0,2">
                            <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource txt-1}" /><Run
                                 Text="   " /><Run Text="{Binding Comment, Mode=OneWay}" FontStyle="Italic" Foreground="{DynamicResource good}" />
                          </TextBlock>
                          <ScrollViewer x:Name="diffRungScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <views:LadderRungView Style="{StaticResource LadderRung}" Text="{Binding Rung}" Shapes="{Binding Shapes}"
                                                  ViewportWidth="{Binding ViewportWidth, ElementName=diffRungScroll}" ViewportInset="4"
                                                  ToolTip="{Binding Rung}" />
                          </ScrollViewer>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
    </DataTemplate>

    <!-- A table or rung in the chat scrolls sideways; the wheel still scrolls the chat. -->
    <Style x:Key="ChatSideScroll" TargetType="ScrollViewer">
      <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
      <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
      <EventSetter Event="PreviewMouseWheel" Handler="OnChatSideScrollWheel" />
    </Style>

    <!-- Handed to the shared title bar by the constructor through Chrome.TitleContent - see the
         note in NetControl's MainWindow on why this is not attribute syntax (MC3089). -->
    <!-- Every action in the window is on this menu, whether or not it also has a button or a key:
         the tabs' toolbars are shortcuts to it. An item that acts on one tab also brings that tab
         forward (Click="OnShowTab"/"OnShowDevelop" beside the Command), so the result is in view. -->
    <Menu x:Key="TitleMenu" Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Center">
      <MenuItem Header="_File">
        <MenuItem Header="_Open L5X export..." Click="OnOpen" InputGestureText="Ctrl+O" />
        <!-- The three recent submenus are filled each time they open (OnRecentSubmenuOpened); the
             placeholder child is what gives an empty one its arrow. Tag says what a click does. -->
        <MenuItem Header="Open _recent" Tag="open" SubmenuOpened="OnRecentSubmenuOpened"
                  ToolTip="Exports and development sets opened lately">
          <MenuItem Header="(nothing yet)" IsEnabled="False" />
        </MenuItem>
        <MenuItem Header="Reopen las_t export" Click="OnReopenLastExport" InputGestureText="Ctrl+Shift+O" />
        <Separator />
        <MenuItem Header="Add a _controller to the system view..." Click="OnAddController"
                  ToolTip="Open another controller's export beside this one, to see and check how they talk to each other" />
        <MenuItem Header="Add a recent controller to the system _view" Tag="add" SubmenuOpened="OnRecentSubmenuOpened"
                  IsEnabled="{Binding HasProject}">
          <MenuItem Header="(nothing yet)" IsEnabled="False" />
        </MenuItem>
        <Separator />
        <MenuItem Header="Re_load" Command="{Binding ReloadCommand}" InputGestureText="F5"
                  ToolTip="Read the same file again - after a fresh export from Studio 5000." />
        <MenuItem Header="Show in _Explorer" Click="OnRevealExport" IsEnabled="{Binding HasProject}"
                  ToolTip="Open the folder the export is in, with the file selected." />
        <MenuItem Header="Copy _path" Click="OnCopyExportPath" IsEnabled="{Binding HasProject}" />
        <MenuItem Header="Close pro_ject" Command="{Binding CloseCommand}" />
        <Separator />
        <MenuItem Header="_New development set" Click="OnDevelopNew" />
        <MenuItem Header="Open _development set..." Click="OnDevelopOpen" />
        <MenuItem Header="_Save development set" Click="OnDevelopSave" InputGestureText="Ctrl+S" />
        <MenuItem Header="Save development set _as..." Click="OnDevelopSaveAs" InputGestureText="Ctrl+Shift+S" />
        <Separator />
        <MenuItem Header="E_xit" Click="OnExit" InputGestureText="Alt+F4" />
      </MenuItem>

      <MenuItem Header="_View">
        <MenuItem Header="_Overview" Click="OnShowTab" Tag="0" InputGestureText="Ctrl+1" />
        <MenuItem Header="_Hardware" Click="OnShowTab" Tag="1" InputGestureText="Ctrl+2" />
        <MenuItem Header="_Communications" Click="OnShowTab" Tag="2" InputGestureText="Ctrl+3" />
        <MenuItem Header="_System" Click="OnShowTab" Tag="3" InputGestureText="Ctrl+4" />
        <MenuItem Header="_Tags" Click="OnShowTab" Tag="4" InputGestureText="Ctrl+5" />
        <MenuItem Header="_Logic" Click="OnShowTab" Tag="5" InputGestureText="Ctrl+6" />
        <MenuItem Header="_Findings" Click="OnShowTab" Tag="6" InputGestureText="Ctrl+7" />
        <MenuItem Header="_Develop" Click="OnShowDevelop" InputGestureText="Ctrl+8" />
        <MenuItem Header="Co_mpare" Click="OnShowTab" Tag="8" InputGestureText="Ctrl+9" />
        <Separator />
        <MenuItem Header="F_ilter..." Click="OnFocusFilter" InputGestureText="Ctrl+F"
                  ToolTip="Narrow every grid at once - modules, links, tags, findings" />
        <MenuItem Header="Clear filte_r" Command="{Binding ClearFilterCommand}" InputGestureText="Esc" />
        <Separator />
        <MenuItem Header="System _view zoom" DataContext="{Binding SystemView}">
          <MenuItem Header="Zoom _in" Command="{Binding ZoomInCommand}" Click="OnShowTab" Tag="3" />
          <MenuItem Header="Zoom _out" Command="{Binding ZoomOutCommand}" Click="OnShowTab" Tag="3" />
          <MenuItem Header="_Fit" Command="{Binding ZoomResetCommand}" Click="OnShowTab" Tag="3" />
        </MenuItem>
        <Separator />
        <MenuItem Header="Claude assista_nt" IsCheckable="True" IsChecked="{Binding Assistant.IsOpen, Mode=TwoWay}" InputGestureText="Ctrl+Shift+A" />
        <!-- The same three axes as Redline PDF, the DWG viewer, File Manager and NetControl. -->
        <MenuItem Header="_Appearance..." Click="OnAppearance"
                  ToolTip="Theme, accent colour and density. Applied as you choose, saved when you press OK." />
      </MenuItem>

      <MenuItem Header="_Logic">
        <MenuItem Header="_Edit this routine" Command="{Binding EditRoutineCommand}" Click="OnShowTab" Tag="5"
                  ToolTip="Change the routine on the Logic tab. Double-click a rung to edit just that one." />
        <MenuItem Header="_Discard edits" Command="{Binding DiscardEditsCommand}" Click="OnShowTab" Tag="5"
                  ToolTip="Drop the draft that edits this routine. The edits stay in the history." />
        <MenuItem Header="Show _original" IsCheckable="True" IsChecked="{Binding ShowOriginal, Mode=TwoWay}"
                  IsEnabled="{Binding RoutineHasEdits}" Click="OnShowTab" Tag="5"
                  ToolTip="Show the project's own routine instead of your edited version" />
        <Separator />
        <MenuItem Header="Draw rungs as _ladder" IsCheckable="True" IsChecked="{Binding ShowLadder, Mode=TwoWay}" InputGestureText="Ctrl+L"
                  ToolTip="Off shows the neutral text Studio 5000 stores" />
        <Separator />
        <MenuItem Header="_Ask Claude to explain this routine" IsEnabled="{Binding HasRoutine}"
                  Command="{Binding Assistant.AskCommand}"
                  CommandParameter="Explain the routine I have open: what it does, what drives its outputs, and anything that looks wrong." />
      </MenuItem>

      <MenuItem Header="_Develop" DataContext="{Binding Develop}">
        <MenuItem Header="New _data type" Command="{Binding NewDataTypeCommand}" Click="OnShowDevelop" />
        <MenuItem Header="New _Add-On Instruction" Command="{Binding NewAoiCommand}" Click="OnShowDevelop" />
        <MenuItem Header="New _program" Command="{Binding NewProgramCommand}" Click="OnShowDevelop" ToolTip="A program with a main routine" />
        <MenuItem Header="New _routine" Command="{Binding NewRoutineCommand}" Click="OnShowDevelop" ToolTip="A ladder routine" />
        <MenuItem Header="New _module" Command="{Binding NewModuleCommand}" Click="OnShowDevelop"
                  ToolTip="A Generic Ethernet module - a device the controller connects to by assembly instance" />
        <MenuItem Header="_Tags" Command="{Binding EditTagsCommand}" Click="OnShowDevelop" ToolTip="The drafted tags" />
        <MenuItem Header="From t_emplate..." Command="{Binding FromTemplateCommand}" Click="OnShowDevelop"
                  ToolTip="Generate a UDT, tags and rungs for a list of motors, valves, alarms..." />
        <Separator />
        <MenuItem Header="De_lete draft" Command="{Binding DeleteCommand}" Click="OnShowDevelop" ToolTip="Delete the selected draft" />
        <MenuItem Header="_Clear all drafts" Command="{Binding ClearCommand}" Click="OnShowDevelop"
                  ToolTip="Remove every draft. A revision is recorded, so History can bring them back." />
        <Separator />
        <MenuItem Header="_History" Command="{Binding ShowHistoryCommand}" Click="OnShowDevelop"
                  ToolTip="Every step of this work: what each changed, and go back to any of them" />
        <MenuItem Header="Changes _vs project" Command="{Binding ShowProjectChangesCommand}" Click="OnShowDevelop"
                  ToolTip="What the drafts change in the open project, rung by rung" />
        <Separator />
        <MenuItem Header="E_xport import files..." Click="OnDevelopExport" IsEnabled="{Binding CanExport}"
                  ToolTip="One L5X per item, numbered in import order, for Studio 5000's Import" />
        <MenuItem Header="_Write into project copy..." Click="OnDevelopMerge" IsEnabled="{Binding CanMerge}"
                  ToolTip="{Binding MergeHint}" ToolTipService.ShowOnDisabled="True" />
      </MenuItem>

      <MenuItem Header="_Compare">
        <MenuItem Header="Compare with another _export..." Click="OnCompareWith"
                  ToolTip="Compare the open project with another L5X export - a backup, another line, a contractor's version" />
        <MenuItem Header="Compare with a _recent export" Tag="compare" SubmenuOpened="OnRecentSubmenuOpened"
                  IsEnabled="{Binding HasProject}">
          <MenuItem Header="(nothing yet)" IsEnabled="False" />
        </MenuItem>
        <Separator />
        <MenuItem Header="_Swap direction" Command="{Binding Compare.SwapCommand}" Click="OnShowTab" Tag="8"
                  ToolTip="Read the other export as the starting point instead" />
        <MenuItem Header="Show _all differences" Command="{Binding Compare.ShowAllCommand}" Click="OnShowTab" Tag="8" />
        <MenuItem Header="_Use the other version" Command="{Binding Compare.TakeOtherCommand}" Click="OnShowTab" Tag="8"
                  ToolTip="Take the selected difference from the other export into the Develop tab" />
        <Separator />
        <MenuItem Header="Ask Claude to review the c_omparison" Command="{Binding Compare.ReviewAllCommand}" />
        <MenuItem Header="Ask Claude about the selected _difference" Command="{Binding Compare.ReviewSelectedCommand}" />
        <Separator />
        <MenuItem Header="_Close the comparison" Command="{Binding Compare.CloseCommand}" />
      </MenuItem>

      <MenuItem Header="Cl_aude" DataContext="{Binding Assistant}">
        <MenuItem Header="Claude _panel" IsCheckable="True" IsChecked="{Binding IsOpen, Mode=TwoWay}" InputGestureText="Ctrl+Shift+A" />
        <MenuItem Header="_New chat" Command="{Binding NewChatCommand}" />
        <MenuItem Header="_Stop" Command="{Binding StopCommand}" ToolTip="Stop the answer in progress" />
        <MenuItem Header="Show Claude's _drafts in Develop" Click="OnShowAssistantDrafts" />
        <Separator />
        <MenuItem Header="Claude _Code">
          <MenuItem Header="_Check again" Command="{Binding CheckClaudeCodeCommand}"
                    ToolTip="Look for Claude Code and whether it is signed in" />
          <MenuItem Header="_Sign in..." Click="OnSignInClaudeCode" IsEnabled="{Binding UsesClaudeCode}" />
          <MenuItem Header="_Locate claude.exe..." Click="OnLocateClaudeCode" />
          <MenuItem Header="_Install guide..." Click="OnInstallClaudeCode" />
        </MenuItem>
        <MenuItem Header="_API key">
          <MenuItem Header="_Get a key..." Click="OnGetApiKey" />
          <MenuItem Header="_Forget the saved key" Command="{Binding ForgetKeyCommand}" />
        </MenuItem>
      </MenuItem>

      <MenuItem Header="_Help">
        <MenuItem Header="How to export an _L5X..." Click="OnHowToExport" />
        <MenuItem Header="_Keyboard shortcuts..." Click="OnShortcuts" />
        <Separator />
        <MenuItem Header="Check for _updates..." Click="OnCheckForUpdates" />
        <MenuItem Header="_Releases page" Click="OnOpenReleases" />
        <MenuItem Header="Open the diagnostic lo_g folder" Click="OnOpenLogFolder" />
        <Separator />
        <MenuItem Header="_About LogicControl" Click="OnAbout" />
      </MenuItem>
    </Menu>

    <!-- Navigator rows: icon, name, a muted badge, and a status dot when something is wrong. -->
    <HierarchicalDataTemplate DataType="{x:Type vm:NavNodeViewModel}" ItemsSource="{Binding Children}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="22" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="14" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Style="{StaticResource Glyph}" FontSize="13" Text="{Binding Glyph}" />
        <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Style="{StaticResource Muted}" Text="{Binding Badge}" Margin="8,0,0,0" VerticalAlignment="Center" />
        <Ellipse Grid.Column="3" Style="{StaticResource LevelDot}" HorizontalAlignment="Right" />
      </Grid>
    </HierarchicalDataTemplate>
  </Window.Resources>

  <Grid Margin="8,0,8,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="{DynamicResource status-h-grid}" />
    </Grid.RowDefinitions>

    <!-- ================================================================ toolbar -->
    <DockPanel Grid.Row="0" Margin="2,2,2,8" LastChildFill="False">
      <Button DockPanel.Dock="Left" Style="{StaticResource PrimaryButton}" Click="OnOpen"
              ToolTip="Open a Studio 5000 L5X export (Ctrl+O). You can also drop the file on this window.">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Glyph}" FontSize="12" Text="&#xE8E5;" Margin="0,0,8,0" />
          <TextBlock Text="Open L5X" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Command="{Binding ReloadCommand}"
              ToolTip="Read the file again (F5)">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Glyph}" FontSize="12" Text="&#xE72C;" Margin="0,0,6,0" />
          <TextBlock Text="Reload" VerticalAlignment="Center" />
        </StackPanel>
      </Button>

      <Border DockPanel.Dock="Left" Style="{StaticResource ToolbarSeparator}" />

      <!-- The filter: narrows every grid at once. A watermark rather than a label, so the toolbar
           stays one quiet row. -->
      <Grid DockPanel.Dock="Left" Width="320" VerticalAlignment="Center">
        <TextBox x:Name="SearchBox" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                 Padding="26,0,8,0" VerticalContentAlignment="Center" />
        <TextBlock Style="{StaticResource Glyph}" FontSize="12" Text="&#xE721;" Margin="9,0,0,0"
                   Foreground="{DynamicResource txt-2}" IsHitTestVisible="False" HorizontalAlignment="Left" />
        <TextBlock Text="Filter modules, links, tags, findings   (Ctrl+F)" Margin="27,0,0,0"
                   VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource txt-2}">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>

      <!-- Claude, at the far right like the chat panel it opens. -->
      <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding Assistant.IsOpen, Mode=TwoWay}" Margin="10,0,0,0"
                    ToolTip="Claude assistant (Ctrl+Shift+A)" Height="{DynamicResource tbtn-h}" Padding="10,0" Cursor="Hand">
        <ToggleButton.Template>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="chrome" Background="{DynamicResource bg-2}" BorderBrush="{DynamicResource line}" BorderThickness="1"
                    CornerRadius="{DynamicResource corner-sm}" Padding="{TemplateBinding Padding}">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Glyph}" FontSize="12" Text="&#xE8BD;" Foreground="{DynamicResource accent-on-chrome}" Margin="0,0,6,0" />
                <TextBlock x:Name="label" Text="Claude" Foreground="{DynamicResource txt-1}" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="chrome" Property="Background" Value="{DynamicResource bg-3}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="chrome" Property="Background" Value="{DynamicResource accent-soft}" />
                <Setter TargetName="chrome" Property="BorderBrush" Value="{DynamicResource accent-line}" />
                <Setter TargetName="label" Property="Foreground" Value="{DynamicResource accent-on-chrome}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </ToggleButton.Template>
      </ToggleButton>

      <!-- What is open, at the far right. -->
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                  Visibility="{Binding HasProject, Converter={StaticResource BoolToVisible}}">
        <TextBlock Style="{StaticResource PanelTitle}" Text="{Binding Overview.ControllerName}" VerticalAlignment="Center" />
        <TextBlock Style="{StaticResource Muted}" Text="{Binding Overview.ControllerLine}" Margin="10,0,0,0" VerticalAlignment="Center" />
      </StackPanel>
    </DockPanel>

    <!-- ================================================================ error -->
    <Border Grid.Row="1" Style="{StaticResource FaultNotice}" Margin="2,0,2,8"
            Visibility="{Binding HasError, Converter={StaticResource BoolToVisible}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Click="OnDismissError" Content="Dismiss" />
        <TextBlock Style="{StaticResource FaultText}" Text="{Binding Error}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <!-- ================================================================ empty state -->
    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="2,0,2,8"
            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
        <TextBlock Style="{StaticResource Glyph}" FontSize="44" Text="&#xE8E5;" HorizontalAlignment="Center"
                   Foreground="{DynamicResource accent}" Margin="0,0,0,16" />
        <TextBlock Text="Open a controller" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"
                   Foreground="{DynamicResource txt-0}" />
        <TextBlock Margin="0,10,0,18" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource txt-1}"
                   Text="Drop a Studio 5000 L5X export here, or open one. LogicControl reads the I/O tree, every connection and message, the tags and the logic, and lists what looks wrong." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Button Style="{StaticResource PrimaryButton}" Click="OnOpen" Content="Open L5X export..." />
          <Button Command="{Binding StartDevelopingCommand}" Content="Write logic without a project" Margin="6,0,0,0"
                  ToolTip="Draft data types, AOIs and routines and export them as L5X for Studio 5000 to import" />
        </StackPanel>
        <TextBlock Style="{StaticResource Muted}" Margin="0,18,0,0" TextWrapping="Wrap" TextAlignment="Center"
                   Text="Have an .ACD? In Studio 5000 use File &gt; Save As and set the type to L5X - the .ACD format is Rockwell's own binary and is not read directly." />
      </StackPanel>
    </Border>

    <!-- ================================================================ busy -->
    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="2,0,2,8"
            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <ProgressBar IsIndeterminate="True" Width="220" Height="3" Margin="0,0,0,12" BorderThickness="0"
                     Foreground="{DynamicResource accent}" Background="{DynamicResource bg-3}" />
        <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Center" Foreground="{DynamicResource txt-1}" />
      </StackPanel>
    </Border>

    <!-- ================================================================ workspace -->
    <Grid x:Name="Workspace" Grid.Row="2" Margin="2,0,2,8" Visibility="{Binding ShowWorkspace, Converter={StaticResource BoolToVisible}}"
          SizeChanged="OnWorkspaceSizeChanged">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="NavigatorColumn" Width="{DynamicResource side-w-grid}" MinWidth="160" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" MinWidth="360" />
        <ColumnDefinition x:Name="AssistantSplitterColumn" Width="0" />
        <ColumnDefinition x:Name="AssistantColumn" Width="0" />
      </Grid.ColumnDefinitions>

      <!-- Navigator -->
      <Border Grid.Column="0" Style="{StaticResource Card}" Padding="6,10,6,6">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelHead}" Text="CONTROLLER ORGANIZER" Margin="6,0,0,8" />
          <TreeView x:Name="Navigator" ItemsSource="{Binding Navigator}" SelectedItemChanged="OnNavigatorSelected" />
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Style="{StaticResource ColumnSplitter}" />

      <!-- Tabs -->
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
        <TabControl x:Name="Tabs" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}" Margin="6,4,6,6">

          <!-- ======================================================== overview -->
          <TabItem Header="Overview">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,14,10,10">
              <StackPanel DataContext="{Binding Overview}">
                <TextBlock Text="{Binding ControllerName}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource txt-0}" />
                <TextBlock Text="{Binding ControllerLine}" Foreground="{DynamicResource txt-1}" Margin="0,4,0,0" />
                <TextBlock Text="{Binding ControllerDescription}" Foreground="{DynamicResource txt-1}" Margin="0,2,0,0"
                           Visibility="{Binding ControllerDescription, Converter={StaticResource NotNullToVisible}}" />
                <TextBlock Style="{StaticResource Muted}" Text="{Binding ExportLine}" Margin="0,4,0,18" />

                <ItemsControl ItemsSource="{Binding Cards}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:StatCard}">
                      <Border Background="{DynamicResource bg-1}" BorderBrush="{DynamicResource line-soft}" BorderThickness="1"
                              CornerRadius="{DynamicResource corner}" Padding="14,12" Margin="0,0,10,10">
                        <StackPanel>
                          <TextBlock Style="{StaticResource PanelHead}" Text="{Binding Title}" />
                          <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                            <TextBlock Style="{StaticResource BigNumber}" Text="{Binding Value}" />
                            <TextBlock Style="{StaticResource Muted}" Text="{Binding Unit}" Margin="8,0,0,5" VerticalAlignment="Bottom" />
                          </StackPanel>
                          <TextBlock Style="{StaticResource Muted}" Text="{Binding Detail}" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2*" />
                  </Grid.ColumnDefinitions>

                  <!-- Networks this controller reaches -->
                  <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock Style="{StaticResource PanelHead}" Text="ETHERNET NETWORKS" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Networks}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NetworkSummary}">
                          <Border BorderBrush="{DynamicResource line-soft}" BorderThickness="0,0,0,1" Padding="0,7">
                            <DockPanel>
                              <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center">
                                <Run Text="{Binding Devices, Mode=OneWay}" /><Run Text=" devices" />
                              </TextBlock>
                              <TextBlock Style="{StaticResource Glyph}" Text="&#xE968;" Margin="0,0,8,0" Foreground="{DynamicResource info}" />
                              <StackPanel>
                                <TextBlock Style="{StaticResource MonoText}" Text="{Binding Address}" Foreground="{DynamicResource txt-0}" />
                                <TextBlock Style="{StaticResource Muted}">
                                  <Run Text="via " /><Run Text="{Binding Via, Mode=OneWay}" />
                                </TextBlock>
                              </StackPanel>
                            </DockPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                  <!-- Findings summary -->
                  <StackPanel Grid.Column="1">
                    <DockPanel Margin="0,0,0,8">
                      <TextBlock Style="{StaticResource PanelHead}" Text="FINDINGS" VerticalAlignment="Center" />
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource bad}" VerticalAlignment="Center" />
                        <TextBlock Margin="5,0,14,0" Foreground="{DynamicResource txt-1}">
                          <Run Text="{Binding Errors, Mode=OneWay}" /><Run Text=" errors" />
                        </TextBlock>
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource warn}" VerticalAlignment="Center" />
                        <TextBlock Margin="5,0,14,0" Foreground="{DynamicResource txt-1}">
                          <Run Text="{Binding Warnings, Mode=OneWay}" /><Run Text=" warnings" />
                        </TextBlock>
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource info}" VerticalAlignment="Center" />
                        <TextBlock Margin="5,0,0,0" Foreground="{DynamicResource txt-1}">
                          <Run Text="{Binding Infos, Mode=OneWay}" /><Run Text=" notes" />
                        </TextBlock>
                      </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding TopFindings}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FindingRowViewModel}">
                          <Border BorderBrush="{DynamicResource line-soft}" BorderThickness="0,0,0,1" Padding="0,7">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <Ellipse Grid.Column="0" Style="{StaticResource LevelDot}" VerticalAlignment="Top" Margin="0,5,0,0" />
                              <TextBlock Grid.Column="1" Text="{Binding Subject}" FontWeight="SemiBold" Foreground="{DynamicResource txt-0}"
                                         Margin="0,0,12,0" MaxWidth="200" TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource txt-1}" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource ToolButton}" HorizontalAlignment="Left" Margin="0,8,0,0"
                            Click="OnShowTab" Tag="6" Content="All findings  &#x2192;" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <!-- ======================================================== hardware -->
          <TabItem Header="{Binding HardwareHeader}">
            <Grid Margin="0,8,0,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <DataGrid x:Name="HardwareGrid" Grid.Row="0" ItemsSource="{Binding Hardware}" SelectedItem="{Binding SelectedModule, Mode=TwoWay}"
                        AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                        SelectionMode="Single" CanUserAddRows="False" BorderThickness="0"
                        EnableRowVirtualization="True">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Width="22" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Ellipse Style="{StaticResource LevelDot}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Module" Width="230" SortMemberPath="Name">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                          <Border Width="{Binding Indent}" />
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Catalog" Binding="{Binding Catalog}" Width="150" />
                  <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}" />
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn Header="Rev" Binding="{Binding Revision}" Width="56" />
                  <DataGridTextColumn Header="RPI" Binding="{Binding Rpi}" Width="64" />
                  <DataGridTextColumn Header="Connection" Binding="{Binding Connection}" Width="110" />
                  <DataGridTextColumn Header="Keying" Binding="{Binding Keying}" Width="120" />
                  <DataGridTextColumn Header="Logic refs" Binding="{Binding LogicReferences}" Width="72" />
                  <DataGridTextColumn Header="Notes" Binding="{Binding Flags}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>

              <!-- The selected module: where it is, what it is for, what is wrong with it. -->
              <Border Grid.Row="1" Background="{DynamicResource bg-1}" BorderBrush="{DynamicResource line-soft}" BorderThickness="0,1,0,0"
                      Padding="12,10" DataContext="{Binding SelectedModule}"
                      Visibility="{Binding Converter={StaticResource NotNullToVisible}}">
                <StackPanel>
                  <Button Style="{StaticResource SmallButton}" Content="Edit module..." HorizontalAlignment="Right" Margin="0,0,0,-24"
                          Command="{Binding DataContext.EditModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                          Visibility="{Binding CanDraft, Converter={StaticResource BoolToVisible}}"
                          ToolTip="Draft a change to this Generic Ethernet module - RPI, sizes, address - in the Develop tab" />
                  <TextBlock>
                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource txt-0}" />
                    <Run Text="   " />
                    <Run Text="{Binding Path, Mode=OneWay}" Foreground="{DynamicResource txt-2}" />
                  </TextBlock>
                  <TextBlock Text="{Binding Description}" Foreground="{DynamicResource txt-1}" Margin="0,4,0,0" TextWrapping="Wrap"
                             Visibility="{Binding Description, Converter={StaticResource NotNullToVisible}}" />
                  <ItemsControl ItemsSource="{Binding Findings}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource txt-1}" Margin="0,2,0,0" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </Grid>
          </TabItem>

          <!-- ======================================================== communications -->
          <TabItem Header="{Binding CommsHeader}">
            <DataGrid ItemsSource="{Binding Communications}" Margin="0,8,0,0"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                      SelectionMode="Single" CanUserAddRows="False" BorderThickness="0">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Kind" Width="140" SortMemberPath="Kind">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource KindChip}" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Kind}" Style="{StaticResource Muted}" Foreground="{DynamicResource txt-0}" />
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="From" Binding="{Binding From}" Width="130" />
                <DataGridTextColumn Header="To" Binding="{Binding To}" Width="150" />
                <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="130">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}" />
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="RPI" Binding="{Binding Rpi}" Width="64" />
                <DataGridTextColumn Header="What moves" Binding="{Binding Detail}" Width="2*" />
                <DataGridTextColumn Header="Configured at" Binding="{Binding Source}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>

          <!-- ======================================================== system -->
          <!-- The controller as a system: its I/O tree drawn, the links coloured by kind; with
               more exports added, every controller joined on their produced tags and messages,
               and the problems only the join can show. -->
          <TabItem Header="System">
            <Grid Margin="0,8,0,0" DataContext="{Binding SystemView}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="300" MinWidth="200" />
              </Grid.ColumnDefinitions>

              <DockPanel Grid.Column="0">
                <DockPanel DockPanel.Dock="Top" Margin="6,0,6,8">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolButton}" Command="{Binding ZoomOutCommand}" ToolTip="Zoom out">
                      <TextBlock Style="{StaticResource Glyph}" FontSize="12" Text="&#xE71F;" />
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding ZoomResetCommand}" ToolTip="Actual size" MinWidth="52">
                      <TextBlock Text="{Binding ZoomText}" VerticalAlignment="Center" />
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding ZoomInCommand}" ToolTip="Zoom in">
                      <TextBlock Style="{StaticResource Glyph}" FontSize="12" Text="&#xE8A3;" />
                    </Button>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Muted}" Text="{Binding Summary}" VerticalAlignment="Center" />
                    <!-- Legend: what each line colour means. -->
                    <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                      <Border Width="18" Height="2" Background="{DynamicResource txt-2}" VerticalAlignment="Center" />
                      <TextBlock Style="{StaticResource Muted}" Text="I/O connection" Margin="5,0,12,0" />
                      <Border Width="18" Height="2" Background="{DynamicResource good}" VerticalAlignment="Center" />
                      <TextBlock Style="{StaticResource Muted}" Text="Produced / consumed" Margin="5,0,12,0" />
                      <Border Width="18" Height="2" Background="{DynamicResource info}" VerticalAlignment="Center" />
                      <TextBlock Style="{StaticResource Muted}" Text="Message" Margin="5,0,12,0" />
                      <Border Width="18" Height="2" Background="{DynamicResource accent}" VerticalAlignment="Center" />
                      <TextBlock Style="{StaticResource Muted}" Text="Same controller" Margin="5,0,0,0" />
                    </StackPanel>
                  </StackPanel>
                </DockPanel>

                <Border DockPanel.Dock="Bottom" Background="{DynamicResource bg-1}" BorderBrush="{DynamicResource line-soft}" BorderThickness="0,1,0,0" Padding="12,8">
                  <TextBlock Text="{Binding SelectedDetails}" TextWrapping="Wrap" Foreground="{DynamicResource txt-1}" />
                </Border>

                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource canvas-bg}">
                  <views:TopologyView Style="{StaticResource Topology}" LayoutData="{Binding Layout}"
                                      SelectedNode="{Binding SelectedNode, Mode=TwoWay}" OpenCommand="{Binding OpenNodeCommand}"
                                      HorizontalAlignment="Left" VerticalAlignment="Top">
                    <views:TopologyView.LayoutTransform>
                      <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                    </views:TopologyView.LayoutTransform>
                  </views:TopologyView>
                </ScrollViewer>
              </DockPanel>

              <GridSplitter Grid.Column="1" Style="{StaticResource ColumnSplitter}" />

              <!-- The controllers in the view, and what is wrong between them. -->
              <DockPanel Grid.Column="2" Margin="0,0,6,0">
                <StackPanel DockPanel.Dock="Top">
                  <TextBlock Style="{StaticResource PanelHead}" Text="CONTROLLERS" Margin="0,0,0,6" />
                  <TextBlock Text="{Binding DataContext.Title, RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="SemiBold"
                             Foreground="{DynamicResource txt-0}" TextTrimming="CharacterEllipsis" ToolTip="The main project - the one on the other tabs" />
                  <ItemsControl ItemsSource="{Binding Others}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type vm:PlantProjectRowViewModel}">
                        <DockPanel Margin="0,0,0,6">
                          <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" ToolTip="Take it out of the system view"
                                  Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                            <TextBlock Style="{StaticResource Glyph}" FontSize="10" Text="&#xE8BB;" />
                          </Button>
                          <StackPanel>
                            <Button Style="{StaticResource LinkButton}" Content="{Binding Name}" ToolTip="Make this the main project"
                                    Command="{Binding DataContext.MakeMainCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                            <TextBlock Style="{StaticResource Muted}" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Style="{StaticResource SmallButton}" Content="Add a controller..." Click="OnAddController" HorizontalAlignment="Left" Margin="0,4,0,0"
                          ToolTip="Open another controller's L5X export beside this one" />
                  <TextBlock Text="{Binding Error}" Foreground="{DynamicResource bad}" TextWrapping="Wrap" Margin="0,6,0,0"
                             Visibility="{Binding HasError, Converter={StaticResource BoolToVisible}}" />
                  <TextBlock Style="{StaticResource PanelHead}" Text="BETWEEN CONTROLLERS" Margin="0,16,0,4" />
                  <TextBlock Style="{StaticResource Muted}" Text="{Binding FindingsHeader}" TextWrapping="Wrap" Margin="0,0,0,6" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding Findings}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type vm:FindingRowViewModel}">
                        <Grid Margin="0,0,0,10">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Ellipse Grid.Column="0" Style="{StaticResource LevelDot}" VerticalAlignment="Top" Margin="0,5,0,0" HorizontalAlignment="Left" />
                          <StackPanel Grid.Column="1">
                            <TextBlock>
                              <Run Text="{Binding Subject, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource txt-0}" />
                              <Run Text="{Binding Rule, Mode=OneWay}" Foreground="{DynamicResource txt-2}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource txt-1}" />
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
            </Grid>
          </TabItem>

          <!-- ======================================================== tags -->
          <TabItem Header="{Binding TagsHeader}">
            <Grid Margin="0,8,0,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120" />
                <RowDefinition Height="8" />
                <RowDefinition Height="220" MinHeight="80" />
              </Grid.RowDefinitions>

              <DataGrid Grid.Row="0" ItemsSource="{Binding Tags}" SelectedItem="{Binding SelectedTag, Mode=TwoWay}"
                        AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                        SelectionMode="Single" CanUserAddRows="False" BorderThickness="0"
                        EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" FontWeight="SemiBold" />
                  <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="110" />
                  <DataGridTextColumn Header="Data type" Binding="{Binding DataType}" Width="130" />
                  <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="190" />
                  <DataGridTextColumn Header="Reads" Binding="{Binding Reads}" Width="56" />
                  <DataGridTextColumn Header="Writes" Binding="{Binding Writes}" Width="56" />
                  <DataGridTextColumn Header="Usage" Binding="{Binding Usage}" Width="90" />
                  <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>

              <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" />

              <!-- Cross reference for the selected tag -->
              <DockPanel Grid.Row="2">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelHead}" Margin="4,0,0,6">
                  <Run Text="CROSS REFERENCE  " /><Run Text="{Binding SelectedTag.Name, Mode=OneWay}" Foreground="{DynamicResource txt-0}" />
                </TextBlock>
                <DataGrid ItemsSource="{Binding SelectedTag.Uses}" MouseDoubleClick="OnTagUseDoubleClick"
                          ToolTip="Double-click a use to open its rung"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                          SelectionMode="Single" CanUserAddRows="False" BorderThickness="0">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Access" Binding="{Binding Access}" Width="64" />
                    <DataGridTextColumn Header="Routine" Binding="{Binding Routine}" Width="200" />
                    <DataGridTextColumn Header="Where" Binding="{Binding Location}" Width="80" />
                    <DataGridTextColumn Header="Instruction" Binding="{Binding Instruction}" Width="120" />
                    <DataGridTextColumn Header="Operand" Binding="{Binding Operand}" Width="*">
                      <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}" />
                      </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </Grid>
          </TabItem>

          <!-- ======================================================== logic -->
          <TabItem Header="Logic">
            <DockPanel Margin="0,8,0,0">
              <DockPanel DockPanel.Dock="Top" Margin="6,0,6,10">
                <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Ask Claude" Margin="6,0,0,0"
                        Command="{Binding Assistant.AskCommand}" CommandParameter="Explain the routine I have open: what it does, what drives its outputs, and anything that looks wrong."
                        VerticalAlignment="Center" ToolTip="Have Claude explain this routine in the assistant panel" />
                <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Discard edits" Margin="6,0,0,0"
                        Command="{Binding DiscardEditsCommand}" VerticalAlignment="Center"
                        Visibility="{Binding RoutineHasEdits, Converter={StaticResource BoolToVisible}}"
                        ToolTip="Drop the draft that edits this routine and show the project's own again. The edits stay in the history." />
                <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Edit" Margin="10,0,0,0"
                        Command="{Binding EditRoutineCommand}" VerticalAlignment="Center"
                        ToolTip="Change this routine. The Logic tab then shows your version with every changed rung marked; double-click a rung to edit just that one." />
                <CheckBox DockPanel.Dock="Right" Content="Show original" IsChecked="{Binding ShowOriginal, Mode=TwoWay}" Margin="10,0,0,0"
                          VerticalAlignment="Center" Visibility="{Binding RoutineHasEdits, Converter={StaticResource BoolToVisible}}"
                          ToolTip="Show the project's own routine instead of your edited version" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding Routine.IsLadder, Converter={StaticResource BoolToVisible}, FallbackValue=Collapsed}">
                  <RadioButton Style="{StaticResource SegmentToggle}" Tag="first" Content="Ladder" GroupName="LogicMode"
                               IsChecked="{Binding ShowLadder, Mode=TwoWay}" ToolTip="Draw the rungs as ladder (Ctrl+L)" />
                  <RadioButton Style="{StaticResource SegmentToggle}" Tag="last" Content="Text" GroupName="LogicMode"
                               IsChecked="{Binding ShowText, Mode=TwoWay}" ToolTip="Show the neutral text Studio 5000 stores (Ctrl+L)" />
                </StackPanel>
                <TextBlock Style="{StaticResource PanelTitle}" Text="{Binding Routine.Title}" FontSize="16" VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource Muted}" Text="{Binding Routine.Summary}" Margin="12,0,0,0" VerticalAlignment="Center" />
              </DockPanel>

              <!-- Editing in place: says what is shown, and that it is not in Studio 5000 yet. -->
              <Border DockPanel.Dock="Top" Margin="6,0,6,8" Padding="10,6" CornerRadius="{DynamicResource corner-sm}"
                      Background="{DynamicResource row-warn}" BorderBrush="{DynamicResource warn}" BorderThickness="1"
                      Visibility="{Binding Routine.IsEdited, Converter={StaticResource BoolToVisible}, FallbackValue=Collapsed}">
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource txt-0}">
                  <Run Text="Your edited version" FontWeight="SemiBold" /><Run Text=" - " /><Run Text="{Binding Routine.EditSummary, Mode=OneWay}" /><Run
                       Text=". Green bars are new rungs, amber changed, faded ones removed; hover a bar for what the project has. It reaches Studio 5000 when you export it or write a project copy from the Develop tab." />
                </TextBlock>
              </Border>

              <Grid>
                <!-- Ladder: one drawn rung per row, comment above it, number in the gutter. Scrolls
                     sideways for a rung wider than the window; the rung's own width tracks the
                     visible width so outputs still sit against the right rail. Click an operand
                     to open its tag. -->
                <ItemsControl x:Name="LadderList" ItemsSource="{Binding Routine.Lines}"
                              Visibility="{Binding LadderVisible, Converter={StaticResource BoolToVisible}}"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                  <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                      <ScrollViewer x:Name="LadderScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <ItemsPresenter />
                      </ScrollViewer>
                    </ControlTemplate>
                  </ItemsControl.Template>
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:LogicLineViewModel}">
                      <Border Style="{StaticResource LogicLineRow}" Padding="0,6" ToolTip="{Binding ChangeNote}" MouseLeftButtonDown="OnLogicLineMouseDown">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Border Grid.Column="0" Style="{StaticResource ChangeBar}" Margin="2,0,0,0" />
                          <TextBlock Grid.Column="0" Style="{StaticResource MonoText}" Text="{Binding Number}"
                                     Foreground="{DynamicResource txt-2}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                     Margin="0,4,10,0" />
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Comment}" FontStyle="Italic" Foreground="{DynamicResource good}" TextWrapping="Wrap"
                                       Margin="4,0,12,4" MaxWidth="900" HorizontalAlignment="Left"
                                       Visibility="{Binding HasComment, Converter={StaticResource BoolToVisible}}" />
                            <views:LadderRungView Style="{StaticResource LadderRung}"
                                                  Text="{Binding RungText}"
                                                  Shapes="{Binding DataContext.Routine.Shapes, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  OperandCommand="{Binding DataContext.ShowOperandCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  ViewportWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                  ViewportInset="64" Margin="0,0,8,0" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Text: one row per rung or ST line, the logic as coloured runs that wrap.
                     Virtualised, so a 3,000-rung routine scrolls. -->
                <ItemsControl x:Name="TextList" ItemsSource="{Binding Routine.Lines}"
                              Visibility="{Binding TextVisible, Converter={StaticResource BoolToVisible}}"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True">
                  <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsPresenter />
                      </ScrollViewer>
                    </ControlTemplate>
                  </ItemsControl.Template>
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:LogicLineViewModel}">
                      <Border Style="{StaticResource LogicLineRow}" Padding="0,8" ToolTip="{Binding ChangeNote}" MouseLeftButtonDown="OnLogicLineMouseDown">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Border Grid.Column="0" Style="{StaticResource ChangeBar}" Margin="2,0,0,0" />
                          <TextBlock Grid.Column="0" Style="{StaticResource MonoText}" Text="{Binding Number}"
                                     Foreground="{DynamicResource txt-2}" HorizontalAlignment="Right" Margin="0,0,14,0" />
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Comment}" FontStyle="Italic" Foreground="{DynamicResource good}" TextWrapping="Wrap" Margin="0,0,0,4"
                                       Visibility="{Binding HasComment, Converter={StaticResource BoolToVisible}}" />
                            <ItemsControl ItemsSource="{Binding Segments}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <WrapPanel />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SegmentViewModel}">
                                  <TextBlock Style="{StaticResource Segment}" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </DockPanel>
          </TabItem>

          <!-- ======================================================== findings -->
          <TabItem Header="{Binding FindingsHeader}">
            <DataGrid ItemsSource="{Binding Findings}" Margin="0,8,0,0" MouseDoubleClick="OnFindingDoubleClick"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                      SelectionMode="Single" CanUserAddRows="False" BorderThickness="0" RowHeight="NaN"
                      ToolTip="Double-click a finding to open the rung it is about">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Severity" Width="84" SortMemberPath="Level">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource LevelDot}" Margin="0,0,7,0" />
                        <TextBlock Style="{StaticResource LevelText}" />
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Rule" Binding="{Binding Rule}" Width="90">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}" />
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Area" Binding="{Binding Category}" Width="110" />
                <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="170" FontWeight="SemiBold" />
                <DataGridTextColumn Header="What and why" Binding="{Binding Message}" Width="3*">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                      <Setter Property="TextWrapping" Value="Wrap" />
                      <Setter Property="Margin" Value="0,6" />
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <!-- Each rung or routine is a link that opens it on the Logic tab; findings about
                     hardware keep their plain text. -->
                <DataGridTemplateColumn Header="Where" Width="*" SortMemberPath="Location">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type vm:FindingRowViewModel}">
                      <StackPanel Margin="0,6">
                        <ItemsControl ItemsSource="{Binding Sites}"
                                      Visibility="{Binding HasSites, Converter={StaticResource BoolToVisible}}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Button Style="{StaticResource LinkButton}" Content="{Binding Text}" Margin="0,0,0,2"
                                      Command="{Binding DataContext.OpenSiteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      CommandParameter="{Binding}" ToolTip="Open this on the Logic tab" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Location}" TextWrapping="Wrap" Foreground="{DynamicResource txt-2}"
                                   Visibility="{Binding ShowLocationText, Converter={StaticResource BoolToVisible}}" />
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>

          <!-- ======================================================== develop -->
          <!-- Writing logic: data types, AOIs, programs, routines and tags as drafts, checked as
               they are typed, and exported as L5X for Studio 5000 to import - or written into a
               copy of the open project. The drafts list is on the left, the editor for the one
               selected on the right, and everything wrong with any of them underneath. -->
          <TabItem Header="{Binding DevelopHeader}">
            <Grid Margin="0,8,0,0" DataContext="{Binding Develop}">
              <Grid.Resources>
                <!-- ............................................ the rung list, shared by routines and AOIs -->
                <DataTemplate DataType="{x:Type dev:RungListViewModel}">
                  <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource SmallButton}" Content="Add rung" Command="{Binding AddCommand}" ToolTip="Add a rung below the selected one" />
                        <Button Style="{StaticResource SmallButton}" Content="Duplicate" Command="{Binding DuplicateCommand}" />
                        <Button Style="{StaticResource SmallButton}" Content="Up" Command="{Binding MoveUpCommand}" />
                        <Button Style="{StaticResource SmallButton}" Content="Down" Command="{Binding MoveDownCommand}" />
                        <Button Style="{StaticResource SmallButton}" Content="Delete" Command="{Binding RemoveCommand}" Margin="0,0,14,0" />
                      </StackPanel>
                      <ItemsControl x:Name="Snippets" ItemsSource="{Binding Snippets}" VerticalAlignment="Top">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="{x:Type dev:SnippetViewModel}">
                            <Button Style="{StaticResource SnippetButton}" Content="{Binding Label}" ToolTip="{Binding ToolTip}"
                                    Command="{Binding DataContext.InsertSnippetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding Text}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </DockPanel>

                    <ListBox Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource RungListItem}"
                             ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                             VirtualizingPanel.ScrollUnit="Pixel">
                      <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type dev:RungEditorViewModel}">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="40" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,4,8,0">
                              <TextBlock Style="{StaticResource MonoText}" Text="{Binding Number}" Foreground="{DynamicResource txt-2}" HorizontalAlignment="Right" />
                              <Ellipse Style="{StaticResource LevelDot}" HorizontalAlignment="Right" Margin="0,6,2,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                              <TextBox Text="{Binding Comment, UpdateSourceTrigger=LostFocus}" FontStyle="Italic"
                                       Foreground="{DynamicResource good}" Margin="0,0,0,4" ToolTip="Rung comment" />
                              <TextBox Style="{StaticResource RungBox}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                                       ToolTip="Neutral text, as Studio 5000 stores it: XIC(Start)[XIO(Stop),XIC(Run)]OTE(Run);" />
                              <views:LadderRungView Style="{StaticResource LadderRung}" Text="{Binding Text}" Shapes="{Binding Shapes}" Margin="0,6,0,0" />
                              <ItemsControl ItemsSource="{Binding Problems}" Margin="0,4,0,0"
                                            Visibility="{Binding HasProblems, Converter={StaticResource BoolToVisible}}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource txt-1}" Margin="0,1" />
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </DockPanel>
                </DataTemplate>

                <!-- ............................................ data type -->
                <DataTemplate DataType="{x:Type dev:UdtEditorViewModel}">
                  <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Data type name" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Description" />
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=LostFocus}" />
                      </StackPanel>
                    </Grid>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                      <Button Style="{StaticResource SmallButton}" Content="Add member" Command="{Binding AddCommand}" />
                      <Button Style="{StaticResource SmallButton}" Content="Remove" Command="{Binding RemoveCommand}" />
                      <Button Style="{StaticResource SmallButton}" Content="Up" Command="{Binding MoveUpCommand}" />
                      <Button Style="{StaticResource SmallButton}" Content="Down" Command="{Binding MoveDownCommand}" />
                    </StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="320" />
                      </Grid.ColumnDefinitions>
                      <DataGrid Grid.Column="0" ItemsSource="{Binding Members}" SelectedItem="{Binding SelectedMember, Mode=TwoWay}"
                                AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                                HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single">
                        <DataGrid.Columns>
                          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="170" />
                          <DataGridTemplateColumn Header="Data type" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding DataType}" VerticalAlignment="Center" Margin="4,0" />
                              </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                              <DataTemplate>
                                <ComboBox IsEditable="True" Text="{Binding DataType, UpdateSourceTrigger=LostFocus}"
                                          ItemsSource="{Binding DataContext.TypeChoices, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                              </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                          </DataGridTemplateColumn>
                          <DataGridTextColumn Header="Dim" Binding="{Binding Dimension}" Width="56" />
                          <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                        </DataGrid.Columns>
                      </DataGrid>
                      <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                                   Text="Or paste a member list - one per line: Name : TYPE // description. CSV and Excel columns work too." />
                        <Button DockPanel.Dock="Bottom" Style="{StaticResource SmallButton}" Content="Replace members with this list"
                                Command="{Binding ApplyPasteCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding PasteProblems}" Foreground="{DynamicResource bad}" TextWrapping="Wrap"
                                   Visibility="{Binding PasteProblems, Converter={StaticResource NotNullToVisible}}" Margin="0,6,0,0" />
                        <TextBox Style="{StaticResource MultiLineBox}" Text="{Binding PasteText, UpdateSourceTrigger=PropertyChanged}" />
                      </DockPanel>
                    </Grid>
                  </DockPanel>
                </DataTemplate>

                <!-- ............................................ routine -->
                <DataTemplate DataType="{x:Type dev:RoutineEditorViewModel}">
                  <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Routine name" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Program" />
                        <ComboBox IsEditable="True" ItemsSource="{Binding ProgramChoices}" Text="{Binding Program, UpdateSourceTrigger=LostFocus}" />
                      </StackPanel>
                      <StackPanel Grid.Column="4">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Description" />
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=LostFocus}" />
                      </StackPanel>
                    </Grid>
                    <ContentControl Content="{Binding Rungs}" />
                  </DockPanel>
                </DataTemplate>

                <!-- ............................................ program -->
                <DataTemplate DataType="{x:Type dev:ProgramEditorViewModel}">
                  <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Program name" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,10" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Description" />
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,10" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Main routine" />
                    <ComboBox IsEditable="True" ItemsSource="{Binding RoutineChoices}" Text="{Binding MainRoutineName, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,10" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Schedule in task (when writing into a project copy)" />
                    <ComboBox IsEditable="True" ItemsSource="{Binding TaskChoices}" Text="{Binding Task, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,10" />
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                               Text="Routines and tags drafted with this program's name go inside it. Renaming the program moves them with it." />
                  </StackPanel>
                </DataTemplate>

                <!-- ............................................ generic ethernet module -->
                <DataTemplate DataType="{x:Type dev:ModuleEditorViewModel}">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                      <TextBlock Style="{StaticResource PanelTitle}" Text="{Binding Heading}" Margin="0,0,0,10" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="12" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                          <TextBlock Style="{StaticResource FieldLabel}" Text="Name" />
                          <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,10" />
                          <TextBlock Style="{StaticResource FieldLabel}" Text="Parent (Ethernet bridge)" />
                          <ComboBox IsEditable="True" ItemsSource="{Binding ParentChoices}" Text="{Binding ParentModule, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,10" />
                          <TextBlock Style="{StaticResource FieldLabel}" Text="Comm format" />
                          <ComboBox ItemsSource="{Binding FormatChoices}" SelectedItem="{Binding Format, Mode=TwoWay}" Margin="0,0,0,10" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                          <TextBlock Style="{StaticResource FieldLabel}" Text="IP address" />
                          <TextBox FontFamily="{DynamicResource mono}" Text="{Binding IpAddress, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,10" />
                          <TextBlock Style="{StaticResource FieldLabel}" Text="Parent's Ethernet port" />
                          <TextBox Text="{Binding ParentPortId, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,10" />
                          <TextBlock Style="{StaticResource FieldLabel}" Text="RPI (ms)" />
                          <TextBox Text="{Binding RpiMs, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,10" />
                        </StackPanel>
                      </Grid>

                      <TextBlock Style="{StaticResource PanelHead}" Text="CONNECTION PARAMETERS" Margin="0,6,0,6" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="110" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="12" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldLabel}" Text="Assembly instance" />
                        <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource FieldLabel}" Text="Size (elements; configuration in bytes)" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Input" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding InputInstance, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,6" />
                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding InputSize, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Output" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding OutputInstance, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,6" />
                        <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding OutputSize, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Configuration" VerticalAlignment="Center" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ConfigInstance, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,6" />
                        <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding ConfigSize, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,6" />
                      </Grid>
                      <CheckBox Content="Unicast connection" IsChecked="{Binding Unicast}" Margin="0,4,0,10" />
                      <TextBlock Style="{StaticResource FieldLabel}" Text="Description" />
                      <TextBox Text="{Binding Description, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,12" />
                      <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="{Binding TagsNote}" />
                    </StackPanel>
                  </ScrollViewer>
                </DataTemplate>

                <!-- ............................................ history -->
                <!-- Every revision on the left, newest first; on the right what the selected one
                     changed, rung by rung, with a button to go back to it. The same viewer shows
                     the drafts against the open project. -->
                <DataTemplate DataType="{x:Type dev:HistoryViewModel}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="300" MinWidth="200" />
                      <ColumnDefinition Width="8" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                      <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelHead}" Text="REVISIONS" Margin="4,0,0,6" />
                      <ListBox Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource PlainListItem}"
                               ItemsSource="{Binding Revisions}" SelectedItem="{Binding SelectedRevision, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                          <DataTemplate DataType="{x:Type dev:RevisionRowViewModel}">
                            <Grid Margin="0,3">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <TextBlock Grid.Column="0" Style="{StaticResource MonoText}" Text="{Binding NumberText}" Foreground="{DynamicResource txt-2}" />
                              <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Foreground="{DynamicResource txt-0}" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                  <TextBlock Style="{StaticResource Muted}" Text="{Binding When}" />
                                  <TextBlock Style="{StaticResource Muted}" Text=" · " />
                                  <TextBlock Text="{Binding Author}">
                                    <TextBlock.Style>
                                      <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                        <Style.Triggers>
                                          <DataTrigger Binding="{Binding AuthorKind}" Value="Claude">
                                            <Setter Property="Foreground" Value="{DynamicResource accent-text}" />
                                          </DataTrigger>
                                          <DataTrigger Binding="{Binding AuthorKind}" Value="Template">
                                            <Setter Property="Foreground" Value="{DynamicResource info}" />
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </TextBlock.Style>
                                  </TextBlock>
                                  <TextBlock Style="{StaticResource Muted}" Text="  · current" Visibility="{Binding IsLatest, Converter={StaticResource BoolToVisible}}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Muted}" Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,2,0,0" />
                              </StackPanel>
                            </Grid>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" Style="{StaticResource ColumnSplitter}" />

                    <DockPanel Grid.Column="2">
                      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Go back to this revision"
                                Command="{Binding RevertCommand}" VerticalAlignment="Center"
                                ToolTip="Put every draft back as it was after the selected revision. The revert is recorded too, so it can be undone." />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                          <RadioButton Style="{StaticResource SegmentToggle}" Tag="first" Content="Ladder" GroupName="HistoryDraw"
                                       IsChecked="{Binding ShowLadder, Mode=TwoWay}" ToolTip="Draw changed rungs as ladder" />
                          <RadioButton Style="{StaticResource SegmentToggle}" Tag="last" Content="Text" GroupName="HistoryDraw"
                                       IsChecked="{Binding ShowText, Mode=TwoWay}" ToolTip="List changed rungs as neutral text" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <RadioButton Style="{StaticResource SegmentToggle}" Tag="first" Content="This step" GroupName="HistoryMode"
                                       IsChecked="{Binding IsStep, Mode=TwoWay}" ToolTip="What the selected revision changed" />
                          <RadioButton Style="{StaticResource SegmentToggle}" Content="Since then" GroupName="HistoryMode"
                                       IsChecked="{Binding IsSince, Mode=TwoWay}" ToolTip="Everything changed after the selected revision - what going back would undo" />
                          <RadioButton Style="{StaticResource SegmentToggle}" Tag="last" Content="Against the project" GroupName="HistoryMode"
                                       IsChecked="{Binding IsProject, Mode=TwoWay}" IsEnabled="{Binding HasProject}"
                                       ToolTip="What the drafts change in the open project" />
                        </StackPanel>
                      </DockPanel>
                      <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Text="{Binding Caption}" TextWrapping="Wrap" Margin="0,0,0,8" />

                      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Changes}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type dev:ItemChangeViewModel}">
                              <Border BorderBrush="{DynamicResource line-soft}" BorderThickness="0,0,0,1" Padding="0,8,0,10">
                                <StackPanel>
                                  <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource Chip}" Margin="0,0,8,0">
                                      <TextBlock Text="{Binding KindText}" FontSize="{DynamicResource small-font}" />
                                    </Border>
                                    <Button Style="{StaticResource LinkButton}" Content="{Binding Title}" FontWeight="SemiBold"
                                            Command="{Binding DataContext.OpenDraftCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" ToolTip="Open this draft" VerticalAlignment="Center" />
                                    <TextBlock Style="{StaticResource Muted}" Text="{Binding Summary}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                  </StackPanel>
                                  <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ChangeLines}" />
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </DockPanel>
                  </Grid>
                </DataTemplate>

                <!-- ............................................ add-on instruction -->
                <DataTemplate DataType="{x:Type dev:AoiEditorViewModel}">
                  <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Add-On name" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Revision" />
                        <TextBox Text="{Binding Revision, UpdateSourceTrigger=LostFocus}" />
                      </StackPanel>
                      <StackPanel Grid.Column="4">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Description" />
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=LostFocus}" />
                      </StackPanel>
                    </Grid>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource MonoText}" Foreground="{DynamicResource txt-1}" Margin="0,0,0,8"
                               Text="{Binding CallSignature, StringFormat='Called as  {0}'}" />

                    <Grid DockPanel.Dock="Top" Height="210" Margin="0,0,0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="2*" />
                      </Grid.ColumnDefinitions>
                      <DockPanel Grid.Column="0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                          <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Remove" Command="{Binding RemoveParameterCommand}" Margin="0" />
                          <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Add" Command="{Binding AddParameterCommand}" />
                          <TextBlock Style="{StaticResource PanelHead}" Text="PARAMETERS" VerticalAlignment="Center" />
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding Parameters}" SelectedItem="{Binding SelectedParameter, Mode=TwoWay}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single">
                          <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="130" />
                            <DataGridTemplateColumn Header="Data type" Width="110">
                              <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                  <TextBlock Text="{Binding DataType}" VerticalAlignment="Center" Margin="4,0" />
                                </DataTemplate>
                              </DataGridTemplateColumn.CellTemplate>
                              <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                  <ComboBox IsEditable="True" Text="{Binding DataType, UpdateSourceTrigger=LostFocus}"
                                            ItemsSource="{Binding DataContext.TypeChoices, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                </DataTemplate>
                              </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Usage" Width="86">
                              <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                  <TextBlock Text="{Binding Usage}" VerticalAlignment="Center" Margin="4,0" />
                                </DataTemplate>
                              </DataGridTemplateColumn.CellTemplate>
                              <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                  <ComboBox SelectedItem="{Binding Usage, UpdateSourceTrigger=PropertyChanged}"
                                            ItemsSource="{Binding DataContext.UsageChoices, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                </DataTemplate>
                              </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridCheckBoxColumn Header="Req" Binding="{Binding Required, UpdateSourceTrigger=PropertyChanged}" Width="44" />
                            <DataGridCheckBoxColumn Header="Vis" Binding="{Binding Visible, UpdateSourceTrigger=PropertyChanged}" Width="44" />
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                          </DataGrid.Columns>
                        </DataGrid>
                      </DockPanel>
                      <DockPanel Grid.Column="2">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                          <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Remove" Command="{Binding RemoveLocalCommand}" Margin="0" />
                          <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Add" Command="{Binding AddLocalCommand}" />
                          <TextBlock Style="{StaticResource PanelHead}" Text="LOCAL TAGS" VerticalAlignment="Center" />
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding LocalTags}" SelectedItem="{Binding SelectedLocal, Mode=TwoWay}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single">
                          <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="120" />
                            <DataGridTemplateColumn Header="Data type" Width="110">
                              <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                  <TextBlock Text="{Binding DataType}" VerticalAlignment="Center" Margin="4,0" />
                                </DataTemplate>
                              </DataGridTemplateColumn.CellTemplate>
                              <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                  <ComboBox IsEditable="True" Text="{Binding DataType, UpdateSourceTrigger=LostFocus}"
                                            ItemsSource="{Binding DataContext.TypeChoices, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                </DataTemplate>
                              </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Dim" Binding="{Binding Dimension}" Width="50" />
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                          </DataGrid.Columns>
                        </DataGrid>
                      </DockPanel>
                    </Grid>

                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelHead}" Text="LOGIC" Margin="0,0,0,6" />
                    <ContentControl Content="{Binding Rungs}" />
                  </DockPanel>
                </DataTemplate>

                <!-- ............................................ tags -->
                <DataTemplate DataType="{x:Type dev:TagsEditorViewModel}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="12" />
                      <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Style="{StaticResource SmallButton}" Content="Add tag" Command="{Binding AddCommand}" />
                        <Button Style="{StaticResource SmallButton}" Content="Remove" Command="{Binding RemoveCommand}" />
                      </StackPanel>
                      <DataGrid ItemsSource="{Binding Tags}" SelectedItem="{Binding SelectedTag, Mode=TwoWay}"
                                AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single">
                        <DataGrid.Columns>
                          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160" />
                          <DataGridTemplateColumn Header="Scope" Width="130" SortMemberPath="Scope">
                            <DataGridTemplateColumn.CellTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding Scope}" VerticalAlignment="Center" Margin="4,0" />
                              </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                              <DataTemplate>
                                <ComboBox IsEditable="True" Text="{Binding Scope, UpdateSourceTrigger=LostFocus}"
                                          ItemsSource="{Binding DataContext.ScopeChoices, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                              </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                          </DataGridTemplateColumn>
                          <DataGridTemplateColumn Header="Data type" Width="130" SortMemberPath="DataType">
                            <DataGridTemplateColumn.CellTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding DataType}" VerticalAlignment="Center" Margin="4,0" />
                              </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                              <DataTemplate>
                                <ComboBox IsEditable="True" Text="{Binding DataType, UpdateSourceTrigger=LostFocus}"
                                          ItemsSource="{Binding DataContext.TypeChoices, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                              </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                          </DataGridTemplateColumn>
                          <DataGridTextColumn Header="Dims" Binding="{Binding Dimensions}" Width="60" />
                          <DataGridTextColumn Header="Alias for" Binding="{Binding AliasFor}" Width="140" />
                          <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                        </DataGrid.Columns>
                      </DataGrid>
                    </DockPanel>
                    <DockPanel Grid.Column="2">
                      <TextBlock DockPanel.Dock="Top" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                                 Text="Paste a tag list - Name : TYPE // description per line, or Name, Type, Description columns from Excel." />
                      <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Add these tags" Command="{Binding ApplyPasteCommand}" Margin="6,0,0,0" />
                        <ComboBox IsEditable="True" ItemsSource="{Binding ScopeChoices}" Text="{Binding PasteScope, UpdateSourceTrigger=LostFocus}" ToolTip="Scope for the pasted tags" />
                      </DockPanel>
                      <TextBlock DockPanel.Dock="Bottom" Text="{Binding PasteProblems}" Foreground="{DynamicResource bad}" TextWrapping="Wrap"
                                 Visibility="{Binding PasteProblems, Converter={StaticResource NotNullToVisible}}" Margin="0,6,0,0" />
                      <TextBox Style="{StaticResource MultiLineBox}" Text="{Binding PasteText, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                  </Grid>
                </DataTemplate>

                <!-- ............................................ templates -->
                <DataTemplate DataType="{x:Type dev:TemplateGeneratorViewModel}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="280" />
                      <ColumnDefinition Width="16" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ListBox Grid.Column="0" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource PlainListItem}"
                             ItemsSource="{Binding Templates}" SelectedItem="{Binding Template, Mode=TwoWay}">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                      <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Instances - M101, M102 or a range such as M101-M110" />
                        <TextBox Text="{Binding Instances, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource Muted}" Text="{Binding Preview}" Margin="0,4,0,12" TextWrapping="Wrap" />

                        <Grid Margin="0,0,0,10">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Data type / Add-On name" />
                            <TextBox Text="{Binding TypeName, UpdateSourceTrigger=PropertyChanged}" />
                          </StackPanel>
                          <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Routine name" />
                            <TextBox Text="{Binding Routine, UpdateSourceTrigger=PropertyChanged}" />
                          </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Program" />
                        <ComboBox IsEditable="True" ItemsSource="{Binding ProgramChoices}" Text="{Binding Program, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                        <CheckBox Content="Create this program (it is not in the project yet)" IsChecked="{Binding CreateProgram}" Margin="0,0,0,6" />
                        <ComboBox IsEditable="True" ItemsSource="{Binding TaskChoices}" Text="{Binding Task, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="Task to schedule the new program in" Margin="20,0,0,8"
                                  Visibility="{Binding CreateProgram, Converter={StaticResource BoolToVisible}}" />
                        <CheckBox Content="Program-scoped tags (otherwise controller scope, where the HMI can reach them)" IsChecked="{Binding ProgramScopeTags}" Margin="0,0,0,12" />

                        <ItemsControl ItemsSource="{Binding Settings}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type dev:TemplateSettingRowViewModel}">
                              <StackPanel Margin="0,0,0,8">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Label}" />
                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="160" HorizontalAlignment="Left" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Style="{StaticResource PrimaryButton}" Content="Generate" Command="{Binding GenerateCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource bad}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding Error, Converter={StaticResource NotNullToVisible}}" />
                      </StackPanel>
                    </ScrollViewer>
                  </Grid>
                </DataTemplate>
              </Grid.Resources>

              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="200" />
                <RowDefinition Height="8" />
                <RowDefinition Height="150" MinHeight="60" />
              </Grid.RowDefinitions>

              <!-- Toolbar: make things on the left, take them out on the right. -->
              <DockPanel Grid.Row="0" Margin="6,0,6,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button Style="{StaticResource SmallButton}" Content="Open..." Click="OnDevelopOpen" ToolTip="Open a saved development set (.lcdev)" />
                  <Button Style="{StaticResource SmallButton}" Content="Save..." Click="OnDevelopSave" ToolTip="Save the drafts to carry on later (Ctrl+S)" />
                  <Button Style="{StaticResource SmallButton}" Content="Export import files..." Click="OnDevelopExport" IsEnabled="{Binding CanExport}"
                          ToolTip="Write one L5X per item, numbered in import order, for Studio 5000's Import" />
                  <Button Style="{StaticResource PrimaryButton}" Content="Write into project copy..." Click="OnDevelopMerge" IsEnabled="{Binding CanMerge}"
                          ToolTip="{Binding MergeHint}" ToolTipService.ShowOnDisabled="True" Margin="4,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Button Style="{StaticResource SmallButton}" Content="Data type" Command="{Binding NewDataTypeCommand}" ToolTip="New user-defined data type" />
                  <Button Style="{StaticResource SmallButton}" Content="Add-On" Command="{Binding NewAoiCommand}" ToolTip="New Add-On Instruction" />
                  <Button Style="{StaticResource SmallButton}" Content="Program" Command="{Binding NewProgramCommand}" ToolTip="New program with a main routine" />
                  <Button Style="{StaticResource SmallButton}" Content="Routine" Command="{Binding NewRoutineCommand}" ToolTip="New ladder routine" />
                  <Button Style="{StaticResource SmallButton}" Content="Tags" Command="{Binding EditTagsCommand}" ToolTip="Drafted tags" />
                  <Button Style="{StaticResource SmallButton}" Content="Module" Command="{Binding NewModuleCommand}"
                          ToolTip="New Generic Ethernet module - a device the controller connects to by assembly instance" />
                  <Button Style="{StaticResource SmallButton}" Content="From template..." Command="{Binding FromTemplateCommand}"
                          ToolTip="Generate a UDT, tags and rungs for a list of motors, valves, alarms..." />
                  <Border Style="{StaticResource ToolbarSeparator}" />
                  <Button Style="{StaticResource SmallButton}" Content="Delete" Command="{Binding DeleteCommand}" ToolTip="Delete the selected draft" />
                  <Border Style="{StaticResource ToolbarSeparator}" />
                  <Button Style="{StaticResource SmallButton}" Command="{Binding ShowHistoryCommand}"
                          ToolTip="Every step of this work: what each changed, and go back to any of them">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Style="{StaticResource Glyph}" FontSize="12" Text="&#xE81C;" Margin="0,0,6,0" />
                      <TextBlock Text="History" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource SmallButton}" Content="Changes vs project" Command="{Binding ShowProjectChangesCommand}"
                          ToolTip="What the drafts change in the open project, rung by rung - review before exporting" ToolTipService.ShowOnDisabled="True" />
                </StackPanel>
              </DockPanel>

              <!-- What is open, what it targets, how it stands. -->
              <DockPanel Grid.Row="1" Margin="6,0,6,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Muted}" Text="Controller" VerticalAlignment="Center" Margin="0,0,6,0" />
                  <TextBox Text="{Binding ControllerName, UpdateSourceTrigger=LostFocus}" Width="150" />
                  <TextBlock Style="{StaticResource Muted}" Text="Studio 5000 v" VerticalAlignment="Center" Margin="12,0,4,0" />
                  <TextBox Text="{Binding SoftwareRevision, UpdateSourceTrigger=LostFocus}" Width="60"
                           ToolTip="Stamped on the files. Studio 5000 refuses a file stamped newer than itself." />
                </StackPanel>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource txt-0}" VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource Muted}" Text="{Binding IssueSummary}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
              </DockPanel>

              <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="250" MinWidth="160" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ListBox x:Name="DraftList" Grid.Column="0" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource PlainListItem}"
                         ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
                  <ListBox.GroupStyle>
                    <GroupStyle>
                      <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                          <TextBlock Style="{StaticResource PanelHead}" Text="{Binding Name}" Margin="8,10,0,4" />
                        </DataTemplate>
                      </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                  </ListBox.GroupStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type dev:DraftItemViewModel}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="14" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Style="{StaticResource LevelDot}" VerticalAlignment="Top" Margin="0,5,0,0" HorizontalAlignment="Left" />
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <GridSplitter Grid.Column="1" Style="{StaticResource ColumnSplitter}" />

                <Grid Grid.Column="2" Margin="4,0,6,0">
                  <ContentControl Content="{Binding Editor}" />

                  <!-- Nothing selected: say what this tab is for. -->
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520"
                              Visibility="{Binding Editor, Converter={StaticResource NullToVisible}}">
                    <TextBlock Text="Write logic for Studio 5000" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource txt-0}" HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,16"
                               Text="Draft data types, Add-On Instructions, programs, routines and tags here - or generate them from a template - and LogicControl checks them as you type and draws every rung. Export them as L5X to import into Studio 5000, or write them into a copy of the open project. On the Logic tab, Edit (or double-click a rung) changes an existing routine; every step is kept in History, where any of them can be reviewed and gone back to." />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                      <Button Style="{StaticResource PrimaryButton}" Content="From template..." Command="{Binding FromTemplateCommand}" />
                      <Button Content="New routine" Command="{Binding NewRoutineCommand}" Margin="6,0,0,0" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </Grid>

              <GridSplitter Grid.Row="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows" />

              <!-- Issues: double-click one to open the draft - and the rung - it is about. -->
              <DockPanel Grid.Row="4">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelHead}" Text="CHECKS" Margin="6,0,0,4" />
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" Text="{Binding Message}" TextWrapping="Wrap" Margin="6,6,6,0"
                           Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisible}}" />
                <DataGrid x:Name="IssueGrid" ItemsSource="{Binding Issues}" MouseDoubleClick="OnIssueDoubleClick"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                          SelectionMode="Single" CanUserAddRows="False" BorderThickness="0">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="28" SortMemberPath="Level">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <Ellipse Style="{StaticResource LevelDot}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Where" Binding="{Binding Where}" Width="260" />
                    <DataGridTextColumn Header="What" Binding="{Binding Message}" Width="*" />
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </Grid>
          </TabItem>
          <!-- ======================================================== compare -->
          <!-- The open project against another export: every difference, the selected one drawn
               rung by rung, two routines against each other, the other version taken into the
               Develop tab, and Claude asked to review it with the comparison in its tools. -->
          <TabItem Header="Compare">
            <Grid Margin="0,8,0,0" DataContext="{Binding Compare}">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <!-- What is compared with what -->
              <DockPanel Grid.Row="0" Margin="6,0,6,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button Style="{StaticResource SmallButton}" Content="Swap direction" Command="{Binding SwapCommand}"
                          ToolTip="Read the other export as the starting point instead" />
                  <Button Style="{StaticResource SmallButton}" Content="Close" Command="{Binding CloseCommand}" />
                  <Button Style="{StaticResource PrimaryButton}" Content="Ask Claude to review" Command="{Binding ReviewAllCommand}" Margin="4,0,0,0"
                          ToolTip="Claude reads every difference and says which matter, what looks unintended, and what to keep" />
                </StackPanel>
                <Button DockPanel.Dock="Left" Style="{StaticResource SmallButton}" Content="Compare with..." Click="OnCompareWith"
                        ToolTip="Pick the other L5X export" />
                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding OtherName}" FontWeight="SemiBold" Foreground="{DynamicResource txt-0}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Style="{StaticResource Muted}" Text="{Binding Direction}" TextTrimming="CharacterEllipsis"
                             Visibility="{Binding HasOther, Converter={StaticResource BoolToVisible}}" />
                  <TextBlock Text="{Binding Error}" Foreground="{DynamicResource bad}" TextWrapping="Wrap"
                             Visibility="{Binding HasError, Converter={StaticResource BoolToVisible}}" />
                </StackPanel>
              </DockPanel>

              <!-- Scope, two routines, ladder or text -->
              <WrapPanel Grid.Row="1" Margin="6,0,6,8" Visibility="{Binding HasOther, Converter={StaticResource BoolToVisible}}">
                <TextBlock Style="{StaticResource Muted}" Text="Scope" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox ItemsSource="{Binding Scopes}" SelectedValuePath="Value" SelectedValue="{Binding Scope, Mode=TwoWay}"
                          DisplayMemberPath="Label" Width="190" Margin="0,0,16,4" />
                <TextBlock Style="{StaticResource Muted}" Text="Or routine" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox ItemsSource="{Binding ThisRoutines}" SelectedItem="{Binding ThisRoutine, Mode=TwoWay}" Width="200" Margin="0,0,4,4"
                          ToolTip="A routine in the open project" />
                <TextBlock Style="{StaticResource Muted}" Text="against" VerticalAlignment="Center" Margin="2,0,6,0" />
                <ComboBox ItemsSource="{Binding OtherRoutines}" SelectedItem="{Binding OtherRoutine, Mode=TwoWay}" Width="200" Margin="0,0,4,4"
                          ToolTip="A routine in the other export - it need not have the same name" />
                <Button Style="{StaticResource SmallButton}" Content="Compare routines" Command="{Binding ComparePairCommand}" Margin="0,0,4,4" />
                <Button Style="{StaticResource SmallButton}" Content="All differences" Command="{Binding ShowAllCommand}" Margin="0,0,16,4" />
                <RadioButton Style="{StaticResource SegmentToggle}" Tag="first" Content="Ladder" GroupName="CompareDraw"
                             IsChecked="{Binding ShowLadder, Mode=TwoWay}" Margin="0,0,0,4" />
                <RadioButton Style="{StaticResource SegmentToggle}" Tag="last" Content="Text" GroupName="CompareDraw"
                             IsChecked="{Binding ShowText, Mode=TwoWay}" Margin="0,0,0,4" />
              </WrapPanel>

              <!-- Nothing open yet -->
              <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520"
                          Visibility="{Binding Other, Converter={StaticResource NullToVisible}}">
                <TextBlock Text="Compare with another export" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource txt-0}" HorizontalAlignment="Center" />
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,16"
                           Text="Pick another L5X - a backup, another line, the version a contractor sent back - to see every difference from the open project, rung by rung. Take the other version of anything into the Develop tab, or ask Claude to review the differences." />
                <Button Style="{StaticResource PrimaryButton}" Content="Compare with..." Click="OnCompareWith" HorizontalAlignment="Center" />
              </StackPanel>

              <Grid Grid.Row="2" Visibility="{Binding HasOther, Converter={StaticResource BoolToVisible}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="300" MinWidth="200" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0">
                  <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Text="{Binding Summary}" Margin="6,0,0,6" />
                  <ListBox x:Name="CompareList" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource PlainListItem}"
                           ItemsSource="{Binding Changes}" SelectedItem="{Binding SelectedChange, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                      <DataTemplate DataType="{x:Type dev:ItemChangeViewModel}">
                        <StackPanel Margin="0,2">
                          <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource Chip}" Margin="0,0,6,0">
                              <TextBlock Text="{Binding KindText}" FontSize="{DynamicResource small-font}" />
                            </Border>
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          </StackPanel>
                          <TextBlock Style="{StaticResource Muted}" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>

                <GridSplitter Grid.Column="1" Style="{StaticResource ColumnSplitter}" />

                <DockPanel Grid.Column="2" Margin="4,0,6,0" DataContext="{Binding SelectedChange}"
                           Visibility="{Binding Converter={StaticResource NotNullToVisible}}">
                  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                      <Button Style="{StaticResource SmallButton}" Content="Ask Claude about this"
                              Command="{Binding DataContext.Compare.ReviewSelectedCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                      <Button Style="{StaticResource PrimaryButton}" Margin="4,0,0,0"
                              Content="{Binding DataContext.Compare.TakeOtherText, RelativeSource={RelativeSource AncestorType=Window}}"
                              Command="{Binding DataContext.Compare.TakeOtherCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              ToolTip="Draft the other export's version of this item in the Develop tab, as one revision you can review, change or undo" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource PanelTitle}" Text="{Binding Title}" FontSize="15" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </DockPanel>
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ChangeLines}" />
                  </ScrollViewer>
                </DockPanel>
              </Grid>
            </Grid>
          </TabItem>
        </TabControl>
      </Border>

      <!-- ================================================================ Claude -->
      <!-- The assistant: a chat with Claude that reads the open project through LogicControl's
           tools and writes drafts into the Develop tab. Docked right like the Claude panel in VS
           Code; the column's width is set from code-behind when it opens and closes. -->
      <GridSplitter Grid.Column="3" Style="{StaticResource ColumnSplitter}"
                    Visibility="{Binding Assistant.IsOpen, Converter={StaticResource BoolToVisible}}" />

      <Border Grid.Column="4" Style="{StaticResource Card}" Padding="0" DataContext="{Binding Assistant}"
              Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisible}}">
        <DockPanel>
          <!-- Header -->
          <DockPanel DockPanel.Dock="Top" Margin="12,10,8,8">
            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Command="{Binding ToggleCommand}" ToolTip="Close (Ctrl+Shift+A)">
              <TextBlock Style="{StaticResource Glyph}" FontSize="10" Text="&#xE8BB;" />
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Command="{Binding NewChatCommand}" ToolTip="New chat">
              <TextBlock Style="{StaticResource Glyph}" FontSize="12" Text="&#xE710;" />
            </Button>
            <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Models}" SelectedItem="{Binding Model, Mode=TwoWay}" Width="150" Margin="0,0,6,0"
                      ToolTip="Sonnet is quick; Opus thinks harder about large or tangled logic; Haiku is lightest." />
            <TextBlock Style="{StaticResource PanelHead}" Text="CLAUDE" VerticalAlignment="Center" />
          </DockPanel>

          <!-- Which Claude: the user's own Claude Code on their plan, or an API key. -->
          <DockPanel DockPanel.Dock="Top" Margin="12,0,10,8">
            <ComboBox DockPanel.Dock="Left" SelectedIndex="{Binding BackendIndex, Mode=TwoWay}" Width="200" Margin="0,0,8,0"
                      ToolTip="Your Claude plan runs through Claude Code on this PC - no API key or credits. An API key is billed per use.">
              <ComboBoxItem Content="Your Claude plan (Claude Code)" />
              <ComboBoxItem Content="API key (billed per use)" />
            </ComboBox>
            <TextBlock Style="{StaticResource Muted}" Text="{Binding BackendNote}" TextWrapping="Wrap" VerticalAlignment="Center" />
          </DockPanel>

          <!-- Claude Code not found -->
          <Border DockPanel.Dock="Top" Margin="12,0,12,10" Padding="12" Background="{DynamicResource bg-1}"
                  BorderBrush="{DynamicResource line}" BorderThickness="1" CornerRadius="6"
                  Visibility="{Binding ClaudeCodeMissing, Converter={StaticResource BoolToVisible}}">
            <StackPanel>
              <TextBlock Text="Install Claude Code to use your Claude plan" FontWeight="SemiBold" Foreground="{DynamicResource txt-0}" Margin="0,0,0,6" />
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                         Text="LogicControl runs Claude Code in the background, so the chat uses your Claude subscription instead of API credits. Claude Code's command-line tool was not found on this PC. Install it from PowerShell, then press Check again:" />
              <TextBox Style="{StaticResource ChatText}" FontFamily="{DynamicResource mono}" Text="irm https://claude.ai/install.ps1 | iex" Margin="0,0,0,10" />
              <WrapPanel>
                <Button Style="{StaticResource PrimaryButton}" Content="Check again" Command="{Binding CheckClaudeCodeCommand}" Margin="0,0,6,6" />
                <Button Style="{StaticResource SmallButton}" Content="Install guide..." Click="OnInstallClaudeCode" Margin="0,0,6,6" />
                <Button Style="{StaticResource SmallButton}" Content="Locate claude.exe..." Click="OnLocateClaudeCode" Margin="0,0,6,6"
                        ToolTip="Point LogicControl at a claude.exe it did not find" />
              </WrapPanel>
            </StackPanel>
          </Border>

          <!-- Claude Code not signed in -->
          <Border DockPanel.Dock="Top" Margin="12,0,12,10" Padding="12" Background="{DynamicResource bg-1}"
                  BorderBrush="{DynamicResource line}" BorderThickness="1" CornerRadius="6"
                  Visibility="{Binding ClaudeCodeSignedOut, Converter={StaticResource BoolToVisible}}">
            <StackPanel>
              <TextBlock Text="Sign in to Claude Code" FontWeight="SemiBold" Foreground="{DynamicResource txt-0}" Margin="0,0,0,6" />
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                         Text="Claude Code is installed but not signed in. Sign in once with the Claude account whose plan the chat should use - a browser opens for it - then press Check again." />
              <WrapPanel>
                <Button Style="{StaticResource PrimaryButton}" Content="Sign in..." Click="OnSignInClaudeCode" Margin="0,0,6,6" />
                <Button Style="{StaticResource SmallButton}" Content="Check again" Command="{Binding CheckClaudeCodeCommand}" Margin="0,0,6,6" />
              </WrapPanel>
            </StackPanel>
          </Border>

          <!-- No key yet -->
          <Border DockPanel.Dock="Top" Margin="12,0,12,10" Padding="12" Background="{DynamicResource bg-1}"
                  BorderBrush="{DynamicResource line}" BorderThickness="1" CornerRadius="6"
                  Visibility="{Binding NeedsKey, Converter={StaticResource BoolToVisible}}">
            <StackPanel>
              <TextBlock Text="Connect an Anthropic API key" FontWeight="SemiBold" Foreground="{DynamicResource txt-0}" Margin="0,0,0,6" />
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                         Text="With an API key the assistant talks to Anthropic's API directly, billed per use to the key's account - separate from a Claude subscription, and the account needs credits. To use your Claude plan instead, pick it in the list above. The key is stored encrypted for your Windows account only." />
              <PasswordBox x:Name="ApiKeyBox" Margin="0,0,0,8" MinHeight="{DynamicResource field-h}" VerticalContentAlignment="Center"
                           Background="{DynamicResource bg-2}" Foreground="{DynamicResource txt-0}" BorderBrush="{DynamicResource line}"
                           CaretBrush="{DynamicResource txt-0}" Padding="6,0" />
              <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}" Content="Save key" Click="OnSaveApiKey" />
                <Button Style="{StaticResource SmallButton}" Content="Get a key..." Click="OnGetApiKey" Margin="6,0,0,0" />
              </StackPanel>
              <TextBlock x:Name="ApiKeyError" Foreground="{DynamicResource bad}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
            </StackPanel>
          </Border>

          <!-- Input -->
          <Border DockPanel.Dock="Bottom" Margin="10,6,10,10" Padding="8" Background="{DynamicResource bg-1}"
                  BorderBrush="{DynamicResource line}" BorderThickness="1" CornerRadius="8">
            <DockPanel>
              <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Send" Command="{Binding SendCommand}" MinWidth="70" Margin="0"
                        ToolTip="Send (Enter). Shift+Enter for a new line." />
                <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="Stop" Command="{Binding StopCommand}" MinWidth="64" Margin="0,0,6,0"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />
                <CheckBox Content="Include what I'm looking at" IsChecked="{Binding IncludeContext}" VerticalAlignment="Center"
                          ToolTip="Sends the open routine, selected tag or draft by name with the question, so 'this routine' means something." />
              </DockPanel>
              <TextBox x:Name="AssistantInput" Style="{StaticResource MultiLineBox}" FontFamily="{DynamicResource font}"
                       Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" MinHeight="54" MaxHeight="200"
                       IsEnabled="{Binding IsReady}" PreviewKeyDown="OnAssistantInputKeyDown"
                       ToolTip="Ask about the project, or ask for logic: 'add a jam timer to every conveyor'" />
            </DockPanel>
          </Border>

          <!-- Status and usage -->
          <DockPanel DockPanel.Dock="Bottom" Margin="14,0,12,0">
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" Text="{Binding UsageText}" ToolTip="Tokens used in this chat" />
            <TextBlock Style="{StaticResource Muted}" Text="{Binding Status}" FontStyle="Italic" TextTrimming="CharacterEllipsis" />
          </DockPanel>

          <!-- The chat -->
          <Grid>
            <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          ScrollChanged="OnChatScrollChanged" Padding="12,0,12,6">
              <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.Resources>
                  <DataTemplate DataType="{x:Type asst:ChatMessageViewModel}">
                    <Border x:Name="bubble" Margin="0,4,0,8" Padding="0" CornerRadius="8">
                      <StackPanel>
                        <ItemsControl ItemsSource="{Binding Segments}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type asst:ChatSegment}">
                              <StackPanel Margin="0,2">
                                <!-- A paragraph -->
                                <views:ChatRichText Runs="{Binding Inlines}" Foreground="{DynamicResource txt-1}" Margin="0,2,0,4"
                                                    Visibility="{Binding IsText, Converter={StaticResource BoolToVisible}}" />

                                <!-- A heading -->
                                <views:ChatRichText Runs="{Binding Inlines}" Foreground="{DynamicResource txt-0}" FontWeight="SemiBold" Margin="0,8,0,2"
                                                    Visibility="{Binding IsHeading, Converter={StaticResource BoolToVisible}}" />

                                <!-- A list item: marker, then the text, indented by level -->
                                <Grid Margin="{Binding Indent, Converter={StaticResource LeftMargin}}"
                                      Visibility="{Binding IsBullet, Converter={StaticResource BoolToVisible}}">
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                  </Grid.ColumnDefinitions>
                                  <TextBlock Grid.Column="0" Text="{Binding Marker}" Foreground="{DynamicResource txt-2}" HorizontalAlignment="Right" Margin="0,0,6,0" />
                                  <views:ChatRichText Grid.Column="1" Runs="{Binding Inlines}" Foreground="{DynamicResource txt-1}" Margin="0,1" />
                                </Grid>

                                <!-- A table: scrolls sideways when it is wider than the panel -->
                                <Border Background="{DynamicResource bg-1}" BorderBrush="{DynamicResource line}" BorderThickness="1" CornerRadius="5" Margin="0,4"
                                        Visibility="{Binding IsTable, Converter={StaticResource BoolToVisible}}">
                                  <ScrollViewer Style="{StaticResource ChatSideScroll}">
                                    <views:ChatTable Rows="{Binding Rows}" />
                                  </ScrollViewer>
                                </Border>

                                <!-- Code that is not a rung -->
                                <Border Background="{DynamicResource bg-1}" BorderBrush="{DynamicResource line-soft}" BorderThickness="1" CornerRadius="5" Padding="8,6" Margin="0,4"
                                        Visibility="{Binding IsCode, Converter={StaticResource BoolToVisible}}">
                                  <TextBox Style="{StaticResource ChatText}" FontFamily="{DynamicResource mono}" Text="{Binding Text, Mode=OneWay}" TextWrapping="NoWrap"
                                           HorizontalScrollBarVisibility="Auto" />
                                </Border>

                                <!-- A rung: drawn as ladder, its caption above, its neutral text a click away -->
                                <Border Background="{DynamicResource bg-1}" BorderBrush="{DynamicResource line-soft}" BorderThickness="1" CornerRadius="5" Padding="6,4,6,6" Margin="0,4"
                                        Visibility="{Binding IsRung, Converter={StaticResource BoolToVisible}}">
                                  <StackPanel>
                                    <DockPanel Margin="2,0,0,2">
                                      <ToggleButton x:Name="showText" DockPanel.Dock="Right" Style="{StaticResource ExpanderToggle}"
                                                    ToolTip="Show the rung as text, to copy into Studio 5000" />
                                      <TextBlock Text="{Binding Caption}" Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center"
                                                 Visibility="{Binding HasCaption, Converter={StaticResource BoolToVisible}}" />
                                    </DockPanel>
                                    <ScrollViewer x:Name="rungScroll" Style="{StaticResource ChatSideScroll}">
                                      <views:LadderRungView Style="{StaticResource LadderRung}" Text="{Binding Text}"
                                                            Shapes="{Binding DataContext.Assistant.Shapes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            ViewportWidth="{Binding ViewportWidth, ElementName=rungScroll}" ViewportInset="4" />
                                    </ScrollViewer>
                                    <TextBox Style="{StaticResource ChatText}" FontFamily="{DynamicResource mono}" Text="{Binding Text, Mode=OneWay}" Margin="2,4,2,0"
                                             Visibility="{Binding IsChecked, ElementName=showText, Converter={StaticResource BoolToVisible}}" />
                                  </StackPanel>
                                </Border>
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="copy" Style="{StaticResource SmallButton}" Content="Copy" HorizontalAlignment="Left" Margin="0,2,0,0"
                                Click="OnCopyChatMessage" ToolTip="Copy this answer as text" Visibility="Collapsed" />
                      </StackPanel>
                    </Border>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding IsUser}" Value="True">
                        <Setter TargetName="bubble" Property="Background" Value="{DynamicResource bg-3}" />
                        <Setter TargetName="bubble" Property="Padding" Value="10,6" />
                        <Setter TargetName="bubble" Property="Margin" Value="36,10,0,8" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsUser}" Value="False">
                        <Setter TargetName="copy" Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>

                  <DataTemplate DataType="{x:Type asst:ToolActivityViewModel}">
                    <StackPanel Margin="0,1">
                      <DockPanel>
                        <ToggleButton DockPanel.Dock="Left" Style="{StaticResource ExpanderToggle}" IsChecked="{Binding IsExpanded}"
                                      ToolTip="Show what the tool returned" Margin="0,0,4,0" />
                        <Ellipse DockPanel.Dock="Left" Style="{StaticResource LevelDot}" Margin="0,0,6,0" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Open in Develop" Click="OnShowAssistantDrafts"
                                Visibility="{Binding IsDraft, Converter={StaticResource BoolToVisible}}" Margin="6,0,0,0" />
                        <TextBlock Style="{StaticResource Muted}" Text="{Binding Summary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      </DockPanel>
                      <TextBox Style="{StaticResource ChatText}" FontFamily="{DynamicResource mono}" Text="{Binding Detail, Mode=OneWay}"
                               Foreground="{DynamicResource txt-1}" Margin="22,4,0,6" MaxHeight="260" VerticalScrollBarVisibility="Auto"
                               Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisible}}" />
                    </StackPanel>
                  </DataTemplate>

                  <DataTemplate DataType="{x:Type asst:ChatNoticeViewModel}">
                    <TextBlock x:Name="notice" Text="{Binding Text}" TextWrapping="Wrap" Margin="0,6" Foreground="{DynamicResource txt-2}" FontStyle="Italic" />
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding IsError}" Value="True">
                        <Setter TargetName="notice" Property="Foreground" Value="{DynamicResource bad}" />
                        <Setter TargetName="notice" Property="FontStyle" Value="Normal" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.Resources>
              </ItemsControl>
            </ScrollViewer>

            <!-- An empty chat: what to ask. -->
            <StackPanel VerticalAlignment="Center" Margin="18,0" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}">
              <TextBlock Text="Ask about this project, or ask for logic." FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource txt-0}"
                         TextWrapping="Wrap" Margin="0,0,0,6" />
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14"
                         Text="Claude reads the open export through LogicControl and writes new or changed logic into the Develop tab as drafts. Nothing reaches a controller - you review, export and import through Studio 5000." />
              <ItemsControl ItemsSource="{Binding Suggestions}" Visibility="{Binding IsReady, Converter={StaticResource BoolToVisible}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource SmallButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,6" Padding="10,6"
                            Command="{Binding DataContext.AskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                      <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Grid>
        </DockPanel>
      </Border>
    </Grid>

    <!-- ================================================================ status bar -->
    <DockPanel Grid.Row="3" Margin="4,0">
      <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center"
                 Text="Never connects to a controller - everything goes through Studio 5000" />
      <!-- Only there when a newer build is published. Click to update. -->
      <TextBlock DockPanel.Dock="Right" Text="{Binding UpdateStatus}" Foreground="{DynamicResource accent-on-chrome}"
                 VerticalAlignment="Center" Margin="0,0,18,0" Cursor="Hand" TextDecorations="Underline"
                 MouseLeftButtonUp="OnUpdateStatusClicked" ToolTip="Download and install the new version"
                 Visibility="{Binding UpdateStatus, Converter={StaticResource NotNullToVisible}}" />
      <TextBlock Style="{StaticResource Muted}" Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    </DockPanel>
  </Grid>
</Window>
