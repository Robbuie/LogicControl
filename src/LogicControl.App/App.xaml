<Application x:Class="LogicControl.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LogicControl.App.Views"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>

      <!-- The chrome. Every colour, radius, font and height in it is a {DynamicResource} looked
           up in the token dictionary, which App.OnStartup installs ahead of this one and the
           appearance dialog replaces as you choose. Nothing else may merge a dictionary at
           index 0 - see ThemeDictionary. -->
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Appearance/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <views:NullToVisibilityConverter x:Key="NotNullToVisible" />
      <views:NullToVisibilityConverter x:Key="NullToVisible" Invert="True" />
      <BooleanToVisibilityConverter x:Key="BoolToVisible" />

    </ResourceDictionary>
  </Application.Resources>
</Application>
